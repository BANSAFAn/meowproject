              w: 11,
              h: 24,
              vx: (Math.random() - 0.5) * 2.2 * spd,
              vy: (3.2 + Math.random() * 1.4) * spd,
              color: Math.random() < 0.25 ? 'orange' : 'white'
            });
          }
          if (t > 45 && t % 68 === 0 && t < state.attackDuration - 50) {
            const low = Math.random() < 0.5;
            spawnBlaster(b.x - 42, low ? b.y + b.h - 24 : b.y + 24, 0, bDelay + 3);
          }
        } else if (w === 22) {
          // 22: Double-Spiral Twin Cat-Blasters
          const step = p3 ? 22 : 28;
          if (t > 16 && t % step === 0 && t < state.attackDuration - 50) {
            const ang = (t / step) * 0.48;
            const cx = b.x + b.w / 2, cy = b.y + b.h / 2;
            spawnBlaster(cx + Math.cos(ang) * 160, cy + Math.sin(ang) * 125, ang + Math.PI, bDelay + 2);
            spawnBlaster(cx - Math.cos(ang) * 160, cy - Math.sin(ang) * 125, ang, bDelay + 2);
          }
        } else if (w === 23) {
          // 23: Claustrophobic Vertical Shaft
          const step = p3 ? 28 : 34;
          if (t > 18 && t % step === 0 && t < state.attackDuration - 45) {
            const left = (t / step) % 2 === 0;
            const bw = Math.round(b.w * 0.58);
            state.bones.push({ x: left ? b.x + 2 : b.x + b.w - bw - 2, y: b.y - 16, w: bw, h: 12, vx: 0, vy: 3.1 * spd, color: 'white' });
          }
          if (t > 60 && t % 72 === 0 && t < state.attackDuration - 50) {
            spawnBlaster(state.soul.x, b.y - 42, Math.PI / 2, bDelay + 4);
          }
        } else if (w === 24) {
          // 24: Chaos Gauntlet (Phase 2)
          if (t === 22) triggerWallSlam('down');
          else if (t === 84) triggerWallSlam('left');
          else if (t === 146) {
            state.soul.mode = 'red';
            state.gravDir = 'down';
            sfx.blink();
          } else if (t > 160 && t % 25 === 0 && t < state.attackDuration - 50) {
            const ang = (t / 22) * 0.6;
            const cx = b.x + b.w / 2, cy = b.y + b.h / 2;
            spawnBlaster(cx + Math.cos(ang) * 165, cy + Math.sin(ang) * 128, ang + Math.PI, bDelay);
          }
          if (t > 180 && t % 78 === 0 && t < state.attackDuration - 55) {
            state.bones.push({ x: b.x + b.w + 6, y: b.y + 4, w: 14, h: b.h - 8, vx: -4.2 * spd, vy: 0, color: Math.random() < 0.5 ? 'cyan' : 'orange' });
          }
        } else if (w === 25) {
          // P3-1: Cat-Paw Vertical Crushers + Horizontal Laser
          if (t > 16 && t % 38 === 0 && t < state.attackDuration - 45) {
            const gapX = b.x + 28 + Math.random() * (b.w - 110);
            state.bones.push({ x: b.x, y: b.y - 26, w: Math.max(12, gapX - b.x), h: 22, vx: 0, vy: 4.1, color: 'white' });
            state.bones.push({ x: gapX + 58, y: b.y - 26, w: Math.max(12, b.x + b.w - (gapX + 58)), h: 22, vx: 0, vy: 4.1, color: 'white' });
          }
          if (t > 44 && t % 60 === 0 && t < state.attackDuration - 50) {
            spawnBlaster(b.x - 42, state.soul.y, 0, 26);
          }
        } else if (w === 26) {
          // P3-2: Orbital Yarn Ring + Edge Blasters
          const cx = b.x + b.w / 2, cy = b.y + b.h / 2;
          for (const y of state.yarns) {
            if (typeof y.orbit === 'number') {
              y.orbit += 0.065;
              const rad = 52 + Math.sin(t * 0.05) * 24;
              y.x = cx + Math.cos(y.orbit) * rad;
              y.y = cy + Math.sin(y.orbit) * (rad * 0.85);
            }
          }
          if (t > 24 && t % 44 === 0 && t < state.attackDuration - 48) {
            const side = Math.floor(Math.random() * 4);
            if (side === 0) spawnBlaster(b.x - 40, state.soul.y, 0, 27);
            else if (side === 1) spawnBlaster(b.x + b.w + 40, state.soul.y, Math.PI, 27);
            else if (side === 2) spawnBlaster(state.soul.x, b.y - 40, Math.PI / 2, 27);
            else spawnBlaster(state.soul.x, b.y + b.h + 40, -Math.PI / 2, 27);
          }
        } else if (w === 27) {
          // P3-3: Triple-Direction Gravity Pinball
          if (t > 14 && t % 46 === 0 && t < state.attackDuration - 45) {
            const seq = ['down', 'right', 'up', 'left'];
            triggerWallSlam(seq[Math.floor(t / 46) % 4]);
          }
        } else if (w === 28) {
          // P3-4: Sawtooth Bone Guillotine
          if (t > 14 && t % 22 === 0 && t < state.attackDuration - 45) {
            const stepIdx = Math.floor(t / 22);
            const h1 = 22 + ((stepIdx * 19) % 56);
            state.bones.push({ x: b.x - 14, y: b.y, w: 12, h: h1, vx: 4.5, vy: 0, color: 'white' });
            state.bones.push({ x: b.x + b.w + 4, y: b.y + b.h - h1, w: 12, h: h1, vx: -4.5, vy: 0, color: 'white' });
          }
        } else if (w === 29) {
          // P3-5: Sniper Crosshair Triangle Ambush
          if (t > 18 && t % 48 === 0 && t < state.attackDuration - 48) {
            const cx = b.x + b.w / 2, cy = b.y + b.h / 2;
            const baseAng = Math.random() * Math.PI * 2;
            for (let k = 0; k < 3; k++) {
              const a = baseAng + (k * Math.PI * 2) / 3;
              const bx = cx + Math.cos(a) * 165;
              const by = cy + Math.sin(a) * 130;
              spawnBlaster(bx, by, Math.atan2(state.soul.y - by, state.soul.x - bx), 28);
            }
          }
        } else if (w === 30) {
          // P3-6: Inverted Gravity Ceiling Run + Aimed Blasters
          if (t > 18 && t % 34 === 0 && t < state.attackDuration - 45) {
            const left = (t / 34) % 2 === 0;
            const h = 32 + Math.random() * 24;
            state.bones.push({ x: left ? b.x - 14 : b.x + b.w + 4, y: b.y, w: 12, h, vx: left ? 4.4 : -4.4, vy: 0, color: 'white' });
          }
          if (t > 45 && t % 68 === 0 && t < state.attackDuration - 50) {
            spawnBlaster(state.soul.x, b.y + b.h + 42, -Math.PI / 2, 28);
          }
        } else if (w === 31) {
          // P3-7: Spiral Bone Vortex from Center
          if (t > 16 && t % 14 === 0 && t < state.attackDuration - 45) {
            const cx = b.x + b.w / 2, cy = b.y + b.h / 2;
            const ang = (t / 14) * 0.65;
            for (let k = 0; k < 2; k++) {
              const a = ang + k * Math.PI;
              state.bones.push({
                x: cx - 5, y: cy - 5, w: 10, h: 10,
                vx: Math.cos(a) * 3.8, vy: Math.sin(a) * 3.8,
                color: k === 0 ? 'white' : 'orange'
              });
            }
          }
        } else if (w === 32) {
          // P3-8: Twin Laser Corridor Sweep
          if (t > 16 && t % 30 === 0 && t < state.attackDuration - 45) {
            const prog = ((t / 30) % 6) / 5;
            const yTop = b.y + 18 + prog * (b.h - 86);
            spawnBlaster(b.x - 42, yTop, 0, 26);
            spawnBlaster(b.x + b.w + 42, yTop + 56, Math.PI, 26);
          }
        } else if (w === 33) {
          // P3-9: Blackout Laser X-Cross + Orange Wave
          if (t > 18 && t % 62 === 0 && t < state.attackDuration - 50) {
            state.blackout = 6;
            sfx.blink();
            spawnBlaster(b.x - 36, b.y - 36, Math.PI / 4, 27);
            spawnBlaster(b.x + b.w + 36, b.y - 36, (3 * Math.PI) / 4, 27);
            spawnBlaster(b.x - 36, b.y + b.h + 36, -Math.PI / 4, 27);
            spawnBlaster(b.x + b.w + 36, b.y + b.h + 36, -(3 * Math.PI) / 4, 27);
            state.bones.push({ x: b.x + b.w + 6, y: b.y + 4, w: 14, h: b.h - 8, vx: -4.6, vy: 0, color: 'orange' });
          }
        } else {
          // P3-10 (w === 34): All-Out Final Desperation
          if (t === 20) triggerWallSlam('up');
          else if (t === 76) triggerWallSlam('right');
          else if (t === 132) { state.soul.mode = 'red'; state.gravDir = 'down'; sfx.blink(); }
          if (t > 142 && t % 20 === 0 && t < state.attackDuration - 48) {
            const ang = (t / 20) * 0.58;
            const cx = b.x + b.w / 2, cy = b.y + b.h / 2;
            spawnBlaster(cx + Math.cos(ang) * 165, cy + Math.sin(ang) * 128, ang + Math.PI, 24);
            spawnBlaster(cx - Math.cos(ang) * 165, cy - Math.sin(ang) * 128, ang, 24);
          }
          if (t > 160 && t % 54 === 0 && t < state.attackDuration - 50) {
            state.bones.push({ x: b.x - 16, y: b.y + 4, w: 14, h: b.h - 8, vx: 4.7, vy: 0, color: Math.random() < 0.5 ? 'cyan' : 'orange' });
          }
        }

        for (const p of state.platforms) {
          p.x += p.vx;
          if (p.x < b.x + 6 || p.x + p.w > b.x + b.w - 6) p.vx *= -1;
        }

        for (let i = state.warnings.length - 1; i >= 0; i--) {
          const wn = state.warnings[i];
          wn.timer++;
          if (wn.timer === wn.triggerAt && !wn.done) {
            wn.done = true;
            state.bones.push({ x: wn.x, y: wn.y, w: wn.w, h: wn.h, vx: 0, vy: 0, color: 'white', ttl: 26 });
            sfx.hit();
          }
          if (wn.timer > wn.triggerAt + 8) state.warnings.splice(i, 1);
        }

        const s = state.soul;
        for (const y of state.yarns) {
          if (typeof y.orbit !== 'number') {
            y.x += y.vx * spd;
            y.y += y.vy * spd;
            if (y.x - y.r < b.x + 4 || y.x + y.r > b.x + b.w - 4) y.vx *= -1;
            if (y.y - y.r < b.y + 4 || y.y + y.r > b.y + b.h - 4) y.vy *= -1;
          }
          if (Math.abs(s.x - y.x) < y.r + 5 && Math.abs(s.y - y.y) < y.r + 5) damagePlayer(3, 5);
        }

        const speed = 3.6;
        let dx = 0, dy = 0;
        if (held(['ArrowLeft', 'KeyA'])) dx -= 1;
        if (held(['ArrowRight', 'KeyD'])) dx += 1;
        if (held(['ArrowUp', 'KeyW'])) dy -= 1;
        if (held(['ArrowDown', 'KeyS'])) dy += 1;
        if (state.invertedControls) { dx = -dx; dy = -dy; }

        if (s.mode === 'red') {
          if (dx && dy) { dx *= 0.707; dy *= 0.707; }
          s.x += dx * speed;
          s.y += dy * speed;
          s.moving = Math.abs(dx) > 0 || Math.abs(dy) > 0;
        } else {
          if (state.gravDir === 'down' || state.gravDir === 'up') {
            s.x += dx * speed;
            const jumpKey = state.gravDir === 'down' ? ['ArrowUp', 'KeyW', 'Space'] : ['ArrowDown', 'KeyS', 'Space'];
            const gSign = state.gravDir === 'down' ? 1 : -1;
            if (held(jumpKey) && s.onGround) { s.vy = -7.6 * gSign; s.onGround = false; sfx.jump(); }
            if (!held(jumpKey) && s.vy * gSign < -2.2) s.vy *= 0.72;
            s.vy += 0.38 * gSign;
            s.y += s.vy;
          } else {
            s.y += dy * speed;
            const jumpKey = state.gravDir === 'left' ? ['ArrowRight', 'KeyD', 'Space'] : ['ArrowLeft', 'KeyA', 'Space'];
            const gSign = state.gravDir === 'right' ? 1 : -1;
            if (held(jumpKey) && s.onGround) { s.vx = -7.6 * gSign; s.onGround = false; sfx.jump(); }
            if (!held(jumpKey) && s.vx * gSign < -2.2) s.vx *= 0.72;
            s.vx += 0.38 * gSign;
            s.x += s.vx;
          }
          s.moving = Math.abs(dx) > 0 || Math.abs(dy) > 0 || Math.abs(s.vx) > 0.5 || Math.abs(s.vy) > 0.5;
        }

        let landedOnPlat = false;
        if (s.mode === 'blue' && state.gravDir === 'down' && s.vy >= 0) {
          for (const p of state.platforms) {
            if (s.x > p.x - 4 && s.x < p.x + p.w + 4 && s.y + 8 >= p.y && s.y + 8 <= p.y + 12) {
              s.y = p.y - 8; s.vy = 0; s.x += p.vx; landedOnPlat = true;
            }
          }
        }

        const pad = 10;
        s.onGround = landedOnPlat;
        if (s.x <= b.x + pad) { s.x = b.x + pad; if (state.gravDir === 'left') { s.vx = 0; s.onGround = true; } }
        if (s.x >= b.x + b.w - pad) { s.x = b.x + b.w - pad; if (state.gravDir === 'right') { s.vx = 0; s.onGround = true; } }
        if (s.y <= b.y + pad) { s.y = b.y + pad; if (state.gravDir === 'up') { s.vy = 0; s.onGround = true; } else if (s.vy < 0) s.vy = 0; }
        if (s.y >= b.y + b.h - pad) { s.y = b.y + b.h - pad; if (state.gravDir === 'down') { s.vy = 0; s.onGround = true; } }

        for (let i = state.bones.length - 1; i >= 0; i--) {
          const bn = state.bones[i];
          bn.x += bn.vx; bn.y += bn.vy;
          if (typeof bn.ttl === 'number') {
            bn.ttl--;
            if (bn.ttl <= 0) { state.bones.splice(i, 1); continue; }
          }
          if (s.x + 6 > bn.x && s.x - 6 < bn.x + bn.w && s.y + 6 > bn.y && s.y - 6 < bn.y + bn.h) {
            if (bn.color === 'white') damagePlayer(3, 5);
            else if (bn.color === 'cyan' && s.moving) damagePlayer(3, 5);
            else if (bn.color === 'orange' && !s.moving) damagePlayer(3, 5);
          }
          if (!bn.persistent && (bn.x < b.x - 90 || bn.x > b.x + b.w + 90 || bn.y > b.y + b.h + 90)) state.bones.splice(i, 1);
        }

        for (let i = state.blasters.length - 1; i >= 0; i--) {
          const bl = state.blasters[i];
          bl.timer++;
          if (bl.snapAt > 0 && bl.timer === bl.snapAt) {
            bl.angle = Math.atan2(s.y - bl.y, s.x - bl.x);
            sfx.blink();
          }
          if (bl.timer === bl.delay) { bl.fired = true; state.shake = 10; sfx.beam(); }
          if (bl.fired && bl.timer < bl.delay + bl.fireDur) {
            const cos = Math.cos(bl.angle);
            const sin = Math.sin(bl.angle);
            const rx = s.x - bl.x;
            const ry = s.y - bl.y;
            const proj = rx * cos + ry * sin;
            const perp = Math.abs(-rx * sin + ry * cos);
            if (proj > 0 && perp < 19) damagePlayer(4, 6);
          }
          if (bl.timer > bl.delay + bl.fireDur + 12) state.blasters.splice(i, 1);
        }

        // End wave & handle phase transitions
        if (state.attackTimer >= state.attackDuration) {
          state.turn++;
          state.catEyeGlow = false;
          state.invertedControls = false;
          state.gravDir = 'down';
          state.soul.mode = 'red';
          state.targetBox = { x: 34, y: 252, w: 572, h: 138 };

          const tr = T();
          if (state.bossPhase === 1 && !state.teaRescueUsed && (state.hp === 1 || state.pendingTeaRescue)) {
            state.teaRescueUsed = true;
            state.pendingTeaRescue = false;
            state.hp = 1;
            state.kr = 0;
            state.phase = 'TEA_RESCUE';
            state.teaRescueIdx = 0;
            state.charCount = 0;
            state.bones = [];
            state.blasters = [];
            state.platforms = [];
            state.warnings = [];
            state.yarns = [];
            bgm.pause();
            return;
          }

          if (state.turn >= PHASE3_TURNS) {
            // Player survived ALL 3 phases! Enter Final Tea Dialogue -> BSOD!
            state.phase = 'FINAL_TEA';
            state.teaIdx = 0;
            state.charCount = 0;
            bgm.pause();
            return;
          }

          state.phase = 'MENU';
          if (state.turn === PHASE1_TURNS && state.bossPhase === 1) {
            state.bossPhase = 2;
            setBgmPhase(2);
            state.mercyOffered = true;
            state.boxText = tr.phase2Offer;
            state.catSpeech = tr.phase2Speech;
            state.catSpeechTimer = 260;
          } else if (state.turn === PHASE2_TURNS && state.bossPhase === 2) {
            state.bossPhase = 3;
            setBgmPhase(3);
            state.mercyOffered = false;
            state.catSpeech = tr.phase3Intro;
            state.catSpeechTimer = 240;
            state.boxText = tr.quips3[0];
          } else {
            state.mercyOffered = false;
            if ((state.bossPhase === 1 || state.bossPhase === 2) && !state.catnipGiftUsed && state.items.length <= 2 && Math.random() < 0.45) {
              state.catnipGiftUsed = true;
              for (let g = 0; g < 3; g++) {
                state.items.push({ name: tr.catnipGiftName, heal: 92, desc: tr.catnipGiftDesc });
              }
              sfx.heal();
              state.catSpeech = tr.catnipGiftSpeech;
              state.catSpeechTimer = 240;
              state.boxText = tr.catnipGiftBox;
            } else {
              const list = state.bossPhase === 3 ? tr.quips3 : state.bossPhase === 2 ? tr.quips2 : tr.quips1;
              state.boxText = list[Math.floor(Math.random() * list.length)];
            }
          }
        }
      }

      function triggerGameOver() {
        const tr = T();
        state.phase = 'GAMEOVER';
        state.deathTimer = 0;
        state.deathX = state.soul ? state.soul.x : 320;
        state.deathY = state.soul ? state.soul.y : 320;
        state.heartShards = [];
        const pool = state.bossPhase === 3 ? tr.gameOverP3 : state.bossPhase === 2 ? tr.gameOverP2 : tr.gameOverP1;
        state.gameOverPhrase = pool[Math.floor(Math.random() * pool.length)];
        bgm.pause();
      }

      function damagePlayer(dmg, krAdd) {
        if (state.invuln > 0) return;
        // Phase 1 dynamic script: randomly decides when to save player at 1 HP for tea rescue
        if (
          state.bossPhase === 1 &&
          !state.teaRescueUsed &&
          state.phase === 'ATTACK' &&
          state.turn >= state.teaRescueMinTurn &&
          state.hp - dmg <= 1
        ) {
          state.hp = 1;
          state.kr = 0;
          state.invuln = 65;
          state.pendingTeaRescue = true;
          state.shake = Math.max(state.shake, 5);
          sfx.hit();
          return;
        }
        state.hp = Math.max(0, state.hp - dmg);
        state.kr = Math.min(state.hp, state.kr + krAdd);
        state.invuln = 8;
        state.shake = Math.max(state.shake, 5);
        sfx.hit();
        if (state.hp <= 0) triggerGameOver();
      }

      function update() {
        state.tick++;
        if (state.phase === 'BSOD') {
          for (const k in justPressed) delete justPressed[k];
          return;
        }

        if (state.invuln > 0) state.invuln--;
        if (state.blackout > 0) state.blackout--;
        if (state.shake > 0) state.shake *= 0.82;
        if (state.catSpeechTimer > 0) state.catSpeechTimer--;
        if (state.catDodgeTimer > 0) {
          state.catDodgeTimer--;
          if (state.catDodgeTimer === 0) state.catTargetX = 320;
        }
        state.catX += (state.catTargetX - state.catX) * 0.2;

        if (state.kr > 0 && (state.phase === 'ATTACK' || state.phase === 'MENU')) {
          state.krTimer++;
          if (state.krTimer >= 28) {
            state.krTimer = 0;
            state.kr--;
            if (state.hp > 1) state.hp--;
          }
        }

        ['x', 'y', 'w', 'h'].forEach((k) => {
          state.box[k] += (state.targetBox[k] - state.box[k]) * 0.22;
        });

        const tr = T();

        // AFK / Idle Detection (> 5 minutes of no input)
        if (
          ['INTRO', 'MENU', 'SUBMENU', 'DIALOGUE', 'FIGHT_BAR'].includes(state.phase) &&
          Date.now() - lastActivityTime >= AFK_TRIGGER_MS
        ) {
          state.afkPrevPhase = state.phase;
          state.phase = 'AFK_CHECK';
          state.afkStage = 1;
          state.afkStageStart = Date.now();
          state.charCount = 0;
          afkWokeUp = false;
          bgm.pause();
        }

        if (state.phase === 'AFK_CHECK') {
          const full = state.afkStage === 1 ? tr.afkAsk : tr.afkPanic;
          if (state.charCount < full.length) {
            const prev = Math.floor(state.charCount);
            state.charCount += 0.45;
            if (Math.floor(state.charCount) > prev && full[prev] !== ' ' && full[prev] !== '\n') sfx.voice();
          }
          if (afkWokeUp) {
            afkWokeUp = false;
            state.phase = 'AFK_REPLY';
            state.afkReplyIdx = 0;
            state.charCount = 0;
            state.shake = 10;
            sfx.slam();
          } else {
            const elapsed = Date.now() - state.afkStageStart;
            if (state.afkStage === 1 && elapsed >= AFK_PANIC_MS) {
              state.afkStage = 2;
              state.afkStageStart = Date.now();
              state.charCount = 0;
              state.shake = 6;
              sfx.blink();
            } else if (state.afkStage === 2 && elapsed >= AFK_CLOSE_MS) {
              window.close();
              window.location.replace('about:blank');
            }
          }
          for (const k in justPressed) delete justPressed[k];
          return;
        }

        if (state.phase === 'AFK_REPLY') {
          const full = tr.afkReply[state.afkReplyIdx];
          if (state.charCount < full.length) {
            const prev = Math.floor(state.charCount);
            state.charCount += 0.5;
            if (Math.floor(state.charCount) > prev && full[prev] !== ' ' && full[prev] !== '\n') sfx.voice();
          }
          if (pressed(['KeyZ', 'Enter', 'Space'])) {
            if (state.charCount < full.length) state.charCount = full.length;
            else {
              state.afkReplyIdx++;
              state.charCount = 0;
              if (state.afkReplyIdx >= tr.afkReply.length) {
                state.phase = state.afkPrevPhase || 'MENU';
                lastActivityTime = Date.now();
                tryStartBgm();
              }
            }
          }
          for (const k in justPressed) delete justPressed[k];
          return;
        }

        // Phase 2 & 3 Menu Bone Trick!
        if (state.bossPhase >= 2 && state.phase === 'MENU' && !state.mercyOffered) {
          if (state.tick % (state.bossPhase === 3 ? 75 : 95) === 0) {
            state.menuBones.push({ x: 640, vx: -3.3 });
          }
          const activeBtnX = 34 + state.menuIdx * 150 + 16;
          for (let i = state.menuBones.length - 1; i >= 0; i--) {
            const mb = state.menuBones[i];
            mb.x += mb.vx;
            if (Math.abs(mb.x - activeBtnX) < 12 && state.hp > 1) damagePlayer(1, 0);
            if (mb.x < -20) state.menuBones.splice(i, 1);
          }
        } else {
          state.menuBones = [];
        }

        if (state.phase === 'ENTER') {
          state.enterTimer++;
          if (state.enterTimer >= 96 || (state.enterTimer > 20 && pressed(['KeyZ', 'Enter', 'Space']))) {
            state.phase = 'INTRO';
            state.introIdx = 0;
            state.charCount = 0;
          }
        } else if (state.phase === 'INTRO') {
          const full = tr.intro[state.introIdx];
          if (state.charCount < full.length) {
            const prev = Math.floor(state.charCount);
            state.charCount += 0.55;
            if (Math.floor(state.charCount) > prev && full[prev] !== ' ' && full[prev] !== '\n') sfx.voice();
          }
          if (pressed(['KeyZ', 'Enter', 'Space'])) {
            if (state.charCount < full.length) state.charCount = full.length;
            else {
              state.introIdx++;
              state.charCount = 0;
              if (state.introIdx >= tr.intro.length) state.phase = 'MENU';
            }
          }
        } else if (state.phase === 'TEA_RESCUE') {
          const full = tr.teaRescue[state.teaRescueIdx];
          if (state.charCount < full.length) {
            const prev = Math.floor(state.charCount);
            state.charCount += 0.45;
            if (Math.floor(state.charCount) > prev && full[prev] !== ' ' && full[prev] !== '\n') sfx.voice();
          }
          if (pressed(['KeyZ', 'Enter', 'Space'])) {
            if (state.charCount < full.length) state.charCount = full.length;
            else {
              state.teaRescueIdx++;
              state.charCount = 0;
              if (state.teaRescueIdx >= tr.teaRescue.length) {
                state.hp = state.maxHp;
                state.kr = 0;
                sfx.heal();
                state.phase = 'MENU';
                state.boxText = tr.quips1[Math.floor(Math.random() * tr.quips1.length)];
                setBgmPhase(1, false);
              }
            }
          }
        } else if (state.phase === 'P3_MERCY_TRAP') {
          const full = tr.p3MercyTrap[state.p3MercyIdx];
          if (state.charCount < full.length) {
            const prev = Math.floor(state.charCount);
            state.charCount += 0.48;
            if (Math.floor(state.charCount) > prev && full[prev] !== ' ' && full[prev] !== '\n') sfx.voice();
          }
          if (pressed(['KeyZ', 'Enter', 'Space'])) {
            if (state.charCount < full.length) state.charCount = full.length;
            else {
              state.p3MercyIdx++;
              state.charCount = 0;
              if (state.p3MercyIdx >= tr.p3MercyTrap.length) {
                state.dunked = true;
                state.hp = 0;
                state.kr = 0;
                sfx.beam();
                triggerGameOver();
              }
            }
          }
        } else if (state.phase === 'PET_AIR_DIALOGUE') {
          const full = tr.petAirLines[state.petAirIdx];
          if (state.charCount < full.length) {
            const prev = Math.floor(state.charCount);
            state.charCount += 0.48;
            if (Math.floor(state.charCount) > prev && full[prev] !== ' ' && full[prev] !== '\n') sfx.voice();
          }
          if (pressed(['KeyZ', 'Enter', 'Space'])) {
            if (state.charCount < full.length) state.charCount = full.length;
            else {
              state.petAirIdx++;
              state.charCount = 0;
              if (state.petAirIdx >= tr.petAirLines.length) {
                state.phase = 'MENU';
                state.boxText = tr.quips1[0];
              }
            }
          }
        } else if (state.phase === 'PET_ENDING') {
          if (state.tick % 24 === 0) {
            state.petHearts.push({
              x: 320 + (Math.random() - 0.5) * 90,
              y: 195 + (Math.random() - 0.5) * 20,
              vy: -0.9 - Math.random() * 0.5,
              alpha: 1
            });
          }
          if (state.tick % 50 === 0) {
            playTone(150, 0.14, 'triangle', 0.08, 175);
          }
          for (let i = state.petHearts.length - 1; i >= 0; i--) {
            const h = state.petHearts[i];
            h.y += h.vy;
            h.alpha -= 0.012;
            if (h.alpha <= 0) state.petHearts.splice(i, 1);
          }
          if (Date.now() - state.petEndingStart >= 60000) {
            window.location.href = getHomeUrl();
          }
        } else if (state.phase === 'FINAL_TEA') {
          const full = tr.finalTea[state.teaIdx];
          if (state.charCount < full.length) {
            const prev = Math.floor(state.charCount);
            state.charCount += 0.45;
            if (Math.floor(state.charCount) > prev && full[prev] !== ' ' && full[prev] !== '\n') sfx.voice();
          }
          if (pressed(['KeyZ', 'Enter', 'Space'])) {
            if (state.charCount < full.length) state.charCount = full.length;
            else {
              state.teaIdx++;
              state.charCount = 0;
              if (state.teaIdx >= tr.finalTea.length) {
                triggerBsodFinale();
              }
            }
          }
        } else if (state.phase === 'MENU') {
          if (pressed(['ArrowLeft', 'KeyA'])) { state.menuIdx = (state.menuIdx + 3) % 4; sfx.move(); }
          if (pressed(['ArrowRight', 'KeyD'])) { state.menuIdx = (state.menuIdx + 1) % 4; sfx.move(); }
          if (pressed(['KeyZ', 'Enter', 'Space'])) {
            sfx.select();
            const btn = BUTTONS[state.menuIdx];
            if (btn === 'FIGHT') {
              state.mercyOffered = false;
              state.phase = 'FIGHT_BAR';
              state.fightCursor = 0;
            } else if (btn === 'ACT') {
              state.phase = 'SUBMENU';
              state.subMenuType = 'ACT';
              state.subIdx = 0;
            } else if (btn === 'ITEM') {
              if (state.items.length === 0) state.boxText = tr.invEmpty;
              else { state.phase = 'SUBMENU'; state.subMenuType = 'ITEM'; state.subIdx = 0; }
            } else if (btn === 'MERCY') {
              if (state.bossPhase === 3) {
                bgm.pause();
                state.phase = 'P3_MERCY_TRAP';
                state.p3MercyIdx = 0;
                state.charCount = 0;
                state.catEyeGlow = false;
              } else if (state.mercyOffered) {
                state.phase = 'DUNKED';
                state.dunked = true;
                state.catSpeech = tr.dunkedSpeech;
                state.catSpeechTimer = 300;
                state.targetBox = { x: 250, y: 260, w: 140, h: 120 };
                state.soul.x = 320; state.soul.y = 320;
                sfx.slam();
              } else {
                state.catSpeech = tr.mercyNo;
                state.catSpeechTimer = 100;
                startAttackWave();
              }
            }
          }
        } else if (state.phase === 'DUNKED') {
          if (state.tick % 4 === 0) {
            state.hp = Math.max(0, state.hp - 6);
            sfx.hit();
            state.shake = 8;
            if (state.hp <= 0) triggerGameOver();
          }
        } else if (state.phase === 'SUBMENU') {
          const listLen = state.subMenuType === 'ACT' ? 3 : state.items.length;
          if (pressed(['ArrowUp', 'KeyW', 'ArrowLeft', 'KeyA'])) { state.subIdx = (state.subIdx + listLen - 1) % listLen; sfx.move(); }
          if (pressed(['ArrowDown', 'KeyS', 'ArrowRight', 'KeyD'])) { state.subIdx = (state.subIdx + 1) % listLen; sfx.move(); }
          if (pressed(['KeyX', 'ShiftLeft', 'ShiftRight', 'Escape'])) { state.phase = 'MENU'; sfx.move(); }
          if (pressed(['KeyZ', 'Enter', 'Space'])) {
            sfx.select();
            if (state.subMenuType === 'ACT') {
              if (state.subIdx === 0) {
                state.dialogueText = tr.actCheck;
                state.phase = 'DIALOGUE';
              } else if (state.subIdx === 1) {
                state.petCount++;
                if (state.petCount === 10) {
                  state.phase = 'PET_AIR_DIALOGUE';
                  state.petAirIdx = 0;
                  state.charCount = 0;
                } else {
                  state.dialogueText = tr.actPet.replace('{n}', String(state.petCount));
                  state.phase = 'DIALOGUE';
                }
              } else {
                state.pspsCount++;
                if (state.pspsCount >= 15) {
                  bgm.pause();
                  state.phase = 'PET_ENDING';
                  state.petEndingStart = Date.now();
                  state.petHearts = [];
                } else {
                  state.dialogueText = tr.actPsps;
                  state.phase = 'DIALOGUE';
                }
              }
            } else {
              const it = state.items.splice(state.subIdx, 1)[0];
              state.hp = Math.min(state.maxHp, state.hp + it.heal);
              state.kr = 0;
              state.dialogueText = it.desc;
              state.phase = 'DIALOGUE';
            }
          }
        } else if (state.phase === 'FIGHT_BAR') {
          state.fightCursor += 9;
          if (pressed(['KeyZ', 'Enter', 'Space']) || state.fightCursor >= 540) {
            state.catTargetX = 200;
            state.catDodgeTimer = 45;
            state.catSpeech = tr.dodgeSpeech;
            state.catSpeechTimer = 110;
            startAttackWave();
          }
        } else if (state.phase === 'DIALOGUE') {
          if (pressed(['KeyZ', 'Enter', 'Space'])) { sfx.select(); startAttackWave(); }
        } else if (state.phase === 'ATTACK') {
          updateAttackWave();
        } else if (state.phase === 'GAMEOVER') {
          state.deathTimer++;
          if (state.deathTimer === 35) {
            sfx.crack();
            state.shake = 7;
          } else if (state.deathTimer === 75) {
            sfx.shatter();
            state.shake = 10;
            const angles = [-2.6, -2.1, -1.5, -0.9, -0.4, 0.3, 1.1, 2.3];
            state.heartShards = angles.map((ang, i) => ({
              x: state.deathX + (i % 2 === 0 ? -4 : 4),
              y: state.deathY + (i % 3 - 1) * 3,
              vx: Math.cos(ang) * (2.6 + (i % 3) * 1.1),
              vy: Math.sin(ang) * (3.2 + (i % 2) * 1.4) - 2.4,
              size: i % 2 === 0 ? 5 : 4,
              rot: i * 0.8
            }));
          } else if (state.deathTimer === 110) {
            setBgmPhase('end', true);
          }
          if (state.deathTimer >= 75) {
            for (const sh of state.heartShards) {
              sh.x += sh.vx;
              sh.y += sh.vy;
              sh.vy += 0.22;
            }
          }
          if (state.deathTimer >= 150 && pressed(['KeyZ', 'Enter', 'Space'])) {
            resetGame();
            tryStartBgm();
          }
        }

        for (const k in justPressed) delete justPressed[k];
      }

      function drawButtonIcon(type, x, y, color) {
        ctx.fillStyle = color;
        if (type === 'FIGHT') {
          for (let i = 0; i < 6; i++) ctx.fillRect(x + 2 + i * 2, y + 14 - i * 2, 3, 3);
          ctx.fillRect(x + 1, y + 12, 8, 3);
        } else if (type === 'ACT') {
          ctx.fillRect(x + 2, y + 6, 3, 8);
          ctx.fillRect(x + 7, y + 4, 3, 12);
          ctx.fillRect(x + 12, y + 2, 3, 16);
        } else if (type === 'ITEM') {
          ctx.fillRect(x + 4, y + 2, 6, 3);
          ctx.fillRect(x + 2, y + 6, 10, 11);
          ctx.fillStyle = '#000';
          ctx.fillRect(x + 5, y + 10, 4, 4);
        } else if (type === 'MERCY') {
          for (let i = 0; i < 5; i++) {
            ctx.fillRect(x + 2 + i * 2, y + 4 + i * 2, 3, 3);
            ctx.fillRect(x + 10 - i * 2, y + 4 + i * 2, 3, 3);
          }
        }
      }

      function drawFishbone(bn) {
        ctx.fillStyle = bn.color === 'cyan' ? '#00e5ff' : bn.color === 'orange' ? '#ff7f27' : '#ffffff';
        ctx.fillRect(Math.round(bn.x + 2), Math.round(bn.y + 4), Math.max(4, Math.round(bn.w - 4)), Math.max(4, Math.round(bn.h - 8)));
        ctx.fillRect(Math.round(bn.x), Math.round(bn.y), Math.round(bn.w), 5);
        ctx.fillRect(Math.round(bn.x), Math.round(bn.y + bn.h - 5), Math.round(bn.w), 5);
      }

      function drawBlaster(bl) {
        const chargeRatio = Math.min(1, bl.timer / Math.max(1, bl.delay));
        const firing = bl.fired && bl.timer < bl.delay + bl.fireDur;
        const fade = firing ? Math.max(0, 1 - (bl.timer - bl.delay) / bl.fireDur) : 0;
        const recoil = firing ? Math.round(fade * 10) : 0;
        const mouthOpen = firing || chargeRatio > 0.55;

        const rx = Math.round(bl.x - Math.cos(bl.angle) * recoil);
        const ry = Math.round(bl.y - Math.sin(bl.angle) * recoil);

        // 1. Aiming line or Laser beam blasting out from the cat's open mouth
        ctx.save();
        ctx.translate(rx, ry + (mouthOpen ? 8 : 4));
        ctx.rotate(bl.angle);
        if (!bl.fired) {
          ctx.fillStyle = chargeRatio > 0.72 ? 'rgba(0, 229, 255, 0.75)' : 'rgba(255, 255, 255, 0.45)';
          for (let d = 14; d < 760; d += 14) ctx.fillRect(d, -1, 8, 2);
        } else if (firing) {
          const outerH = Math.round(42 * fade);
          const coreH = Math.round(24 * fade);
          ctx.fillStyle = `rgba(0, 229, 255, ${fade * 0.7})`;
          ctx.fillRect(6, -Math.round(outerH / 2), 800, outerH);
          ctx.fillStyle = `rgba(255, 255, 255, ${fade})`;
          ctx.fillRect(6, -Math.round(coreH / 2), 800, coreH);
        }
        ctx.restore();

        // 2. Unmistakable Upright Pixel-Art Cat Head opening its mouth wide!
        const mat = mouthOpen ? CAT_BLASTER_OPEN : CAT_BLASTER_CLOSED;
        const scale = 3;
        const glowCol = firing
          ? '#ffffff'
          : (Math.floor(bl.timer / 3) % 2 === 0 ? '#00e5ff' : '#ffff00');
        const headTopY = Math.round(ry - (mat.length * scale) / 2);
        drawPixelMatrix(mat, rx, headTopY, scale, glowCol);

        // Crisp pixel whiskers on both cheeks
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(rx - 33, ry + 1, 9, 2);
        ctx.fillRect(rx - 31, ry + 6, 7, 2);
        ctx.fillRect(rx + 24, ry + 1, 9, 2);
        ctx.fillRect(rx + 24, ry + 6, 7, 2);
      }

      function draw() {
        ctx.clearRect(0, 0, 640, 480);
        if (state.blackout > 0 || state.phase === 'BSOD') return;

        ctx.save();
        if (state.shake > 0.5) {
          ctx.translate(Math.round((Math.random() - 0.5) * state.shake), Math.round((Math.random() - 0.5) * state.shake));
        }

        const tr = T();

        if (state.phase === 'ENTER') {
          const et = state.enterTimer;
          // 1. Cat fades in smoothly out of darkness
          const catAlpha = Math.max(0, Math.min(1, (et - 14) / 42));
          if (catAlpha > 0) {
            ctx.save();
            ctx.globalAlpha = catAlpha;
            drawCatSans(320, state.tick, false, false, Math.round((1 - catAlpha) * 14));
            ctx.restore();
          }

          // 2. Battle box expands smoothly from center
          const boxProg = Math.max(0, Math.min(1, (et - 36) / 36));
          if (boxProg > 0) {
            const ease = 1 - Math.pow(1 - boxProg, 3);
            const bw = Math.round(572 * ease);
            const bh = Math.round(138 * ease);
            const bx = Math.round(320 - bw / 2);
            const by = Math.round(321 - bh / 2);
            ctx.fillStyle = '#000000';
            ctx.fillRect(bx, by, bw, bh);
            ctx.strokeStyle = '#ffffff';
            ctx.lineWidth = 5;
            ctx.strokeRect(bx, by, bw, bh);
          }

          // 3. HUD & buttons fade in smoothly
          const uiAlpha = Math.max(0, Math.min(1, (et - 58) / 32));
          if (uiAlpha > 0) {
            ctx.save();
            ctx.globalAlpha = uiAlpha;
            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 19px "Courier New", monospace';
            ctx.fillText(`${tr.playerName}   LV 0`, 34, 417);
            ctx.font = 'bold 14px "Courier New", monospace';
            ctx.fillText('HP', 240, 415);
            ctx.fillStyle = '#ffff00';
            ctx.fillRect(268, 400, 112, 20);
            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 19px "Courier New", monospace';
            ctx.fillText(`${state.hp} / ${state.maxHp}`, 394, 417);
            BUTTONS.forEach((label, idx) => {
              const bx = 34 + idx * 150, by = 432, bw = 118, bh = 40;
              ctx.strokeStyle = '#ff7f27';
              ctx.lineWidth = 3;
              ctx.strokeRect(bx, by, bw, bh);
              drawButtonIcon(label, bx + 10, by + 10, '#ff7f27');
              ctx.fillStyle = '#ff7f27';
              ctx.font = 'bold 21px "Courier New", monospace';
              ctx.fillText(label, bx + 32, by + 28);
            });
            ctx.restore();
          }

          // 4. Red pixel heart glides gently into the FIGHT button
          if (et < 76) {
            const hpProg = Math.min(1, et / 50);
            const hx = Math.round(320 + (50 - 320) * (1 - Math.pow(1 - hpProg, 3)));
            const hy = Math.round(320 + (452 - 320) * (1 - Math.pow(1 - hpProg, 3)));
            const heartAlpha = et > 58 ? Math.max(0, 1 - (et - 58) / 18) : 1;
            ctx.save();
            ctx.globalAlpha = heartAlpha;
            drawPixelHeart(hx, hy, '#ff0000', 1.25);
            ctx.restore();
          }

          ctx.restore();
          return;
        }

        if (state.phase === 'TEA_RESCUE' || state.phase === 'FINAL_TEA') {
          drawCatSans(320, state.tick, false, false, 84);
          ctx.restore();
          return;
        }

        if (state.phase === 'PET_ENDING') {
          drawCatSans(320, state.tick, false, false, 84);

          // Animated pixel petting hand gently stroking the cat's head left-to-right!
          const handX = Math.round(320 + Math.sin(state.tick * 0.09) * 26);
          const handY = Math.round(156 + Math.abs(Math.sin(state.tick * 0.09)) * 6);
          ctx.fillStyle = '#fde68a';
          ctx.fillRect(handX - 16, handY, 32, 12);
          ctx.fillRect(handX - 12, handY + 12, 6, 8);
          ctx.fillRect(handX - 3, handY + 12, 6, 8);
          ctx.fillRect(handX + 6, handY + 12, 6, 8);
          ctx.fillStyle = '#000000';
          ctx.fillRect(handX - 6, handY + 12, 2, 8);
          ctx.fillRect(handX + 3, handY + 12, 2, 8);

          // Floating pixel hearts
          for (const h of state.petHearts) {
            ctx.save();
            ctx.globalAlpha = Math.max(0, h.alpha);
            drawPixelHeart(h.x, h.y, '#ff4d6d', 1.1);
            ctx.restore();
          }

          ctx.fillStyle = '#ffffff';
          ctx.font = 'bold 18px "Courier New", monospace';
          ctx.textAlign = 'center';
          ctx.fillText(tr.petEndingCaption, 320, 388);
          ctx.textAlign = 'left';
          ctx.restore();
          return;
        }

        if (state.invertedControls && state.phase === 'ATTACK') {
          ctx.fillStyle = '#a855f7';
          ctx.fillRect(160, 14, 320, 28);
          ctx.fillStyle = '#ffffff';
          ctx.font = 'bold 14px "Courier New", monospace';
          ctx.textAlign = 'center';
          ctx.fillText(tr.invertedWarn, 320, 33);
          ctx.textAlign = 'left';
        }

        if (state.phase === 'GAMEOVER') {
          const dt = state.deathTimer;
          if (dt < 35) {
            drawPixelHeart(state.deathX, state.deathY, '#ff0000', 1.45);
          } else if (dt < 75) {
            // Cracked pixel heart: split left & right halves with jagged center crack
            const scale = 1.45;
            const rows = HEART_PIXELS.length;
            const cols = HEART_PIXELS[0].length;
            const halfCol = Math.floor(cols / 2);
            const baseX = Math.round(state.deathX - (cols * scale) / 2);
            const baseY = Math.round(state.deathY - (rows * scale) / 2);
            ctx.fillStyle = '#ff0000';
            for (let r = 0; r < rows; r++) {
              const zig = (r % 2 === 0 ? 0 : 1);
              for (let c = 0; c < cols; c++) {
                if (HEART_PIXELS[r][c] !== '1') continue;
                const isRight = c >= halfCol + zig;
                const gapX = isRight ? 3 : -3;
                const gapY = isRight ? 1 : -1;
                ctx.fillRect(
                  Math.round(baseX + c * scale + gapX),
                  Math.round(baseY + r * scale + gapY),
                  Math.ceil(scale),
                  Math.ceil(scale)
                );
              }
            }
          } else {
            // Flying red pixel shards
            ctx.fillStyle = '#ff0000';
            for (const sh of state.heartShards) {
              if (sh.y < 510) {
                ctx.fillRect(Math.round(sh.x), Math.round(sh.y), sh.size, sh.size);
                ctx.fillRect(Math.round(sh.x + 2), Math.round(sh.y - 2), sh.size - 1, sh.size - 1);
              }
            }
          }

          if (dt >= 110) {
            const fade = Math.min(1, (dt - 110) / 60);
            ctx.save();
            ctx.globalAlpha = fade;
            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 42px "Courier New", monospace';
            ctx.textAlign = 'center';
            ctx.fillText(state.dunked ? tr.dunkedOver : tr.gameOver, 320, 178);

            // Wrap phase-specific Game Over taunt phrase cleanly across lines
            ctx.font = 'bold 17px "Courier New", monospace';
            const words = (state.gameOverPhrase || '').split(' ');
            const lines = [];
            let cur = '';
            for (const w of words) {
              const test = cur ? `${cur} ${w}` : w;
              if (ctx.measureText(test).width > 540 && cur) {
                lines.push(cur);
                cur = w;
              } else {
                cur = test;
              }
            }
            if (cur) lines.push(cur);
            lines.forEach((ln, idx) => {
              ctx.fillText(ln, 320, 238 + idx * 26);
            });

            if (dt >= 150) {
              ctx.fillStyle = '#ffff00';
              ctx.fillText(tr.retry, 320, 260 + lines.length * 26 + 34);
            }
            ctx.textAlign = 'left';
            ctx.restore();
          }
          ctx.restore();
          return;
        }

        drawCatSans(state.catX, state.tick, state.catEyeGlow, state.catDodgeTimer > 0);

        const b = state.box;
        ctx.fillStyle = '#000000';
        ctx.fillRect(Math.round(b.x), Math.round(b.y), Math.round(b.w), Math.round(b.h));
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 5;
        ctx.strokeRect(Math.round(b.x), Math.round(b.y), Math.round(b.w), Math.round(b.h));

        if (state.phase === 'MENU') {
          ctx.fillStyle = '#ffffff';
          ctx.font = 'bold 18px "Courier New", monospace';
          state.boxText.split('\n').forEach((line, idx) => ctx.fillText(line, Math.round(b.x + 22), Math.round(b.y + 42 + idx * 28)));
        } else if (state.phase === 'DIALOGUE') {
          ctx.fillStyle = '#ffffff';
          ctx.font = 'bold 18px "Courier New", monospace';
          state.dialogueText.split('\n').forEach((line, idx) => ctx.fillText(line, Math.round(b.x + 22), Math.round(b.y + 42 + idx * 28)));
        } else if (state.phase === 'SUBMENU') {
          ctx.font = 'bold 18px "Courier New", monospace';
          const opts = state.subMenuType === 'ACT' ? tr.actOpts : state.items.map((it) => `* ${it.name}`);
          opts.forEach((label, idx) => {
            const ox = Math.round(b.x + 44 + (idx % 2) * 265);
            const oy = Math.round(b.y + 36 + Math.floor(idx / 2) * 26);
            ctx.fillStyle = idx === state.subIdx ? '#ffff00' : '#ffffff';
            ctx.fillText(label, ox, oy);
            if (idx === state.subIdx) drawPixelHeart(ox - 18, oy - 6, '#ff0000', 1.1);
          });
        } else if (state.phase === 'FIGHT_BAR') {
          drawUndertaleFightTarget(b, state.fightCursor);
        } else if (state.phase === 'ATTACK' || state.phase === 'DUNKED') {
          ctx.save();
          ctx.beginPath();
          ctx.rect(b.x + 3, b.y + 3, b.w - 6, b.h - 6);
          ctx.clip();

          for (const wn of state.warnings) {
            ctx.fillStyle = Math.floor(state.tick / 3) % 2 === 0 ? 'rgba(255, 0, 0, 0.35)' : 'rgba(255, 0, 0, 0.12)';
            ctx.fillRect(wn.x, wn.y, wn.w, wn.h);
            ctx.strokeStyle = '#ff0000';
            ctx.lineWidth = 2;
            ctx.strokeRect(wn.x, wn.y, wn.w, wn.h);
          }

          for (const p of state.platforms) {
            ctx.fillStyle = '#22c55e';
            ctx.fillRect(Math.round(p.x), Math.round(p.y), p.w, 8);
          }

          for (const y of state.yarns) {
            ctx.fillStyle = '#f59e0b';
            ctx.fillRect(Math.round(y.x - y.r), Math.round(y.y - y.r), y.r * 2, y.r * 2);
            ctx.fillStyle = '#000000';
            ctx.fillRect(Math.round(y.x - 4), Math.round(y.y - 2), 8, 2);
            ctx.fillRect(Math.round(y.x - 2), Math.round(y.y + 2), 6, 2);
          }

          if (state.phase === 'DUNKED') {
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(b.x + 4, b.y + 4, b.w - 8, 28);
            ctx.fillRect(b.x + 4, b.y + b.h - 32, b.w - 8, 28);
          }

          state.bones.forEach(drawFishbone);
          ctx.restore();
          state.blasters.forEach(drawBlaster);

          if (state.invuln === 0 || Math.floor(state.tick / 2) % 2 === 0) {
            drawPixelHeart(state.soul.x, state.soul.y, state.soul.mode === 'blue' ? '#003cff' : '#ff0000', 1.15);
          }
        }

        // HUD Bar
        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 19px "Courier New", monospace';
        ctx.fillText(`${tr.playerName}   LV 0`, 34, 417);
        ctx.font = 'bold 14px "Courier New", monospace';
        ctx.fillText('HP', 240, 415);

        const barX = 268, barY = 400, barW = 112, barH = 20;
        ctx.fillStyle = '#ff0000';
        ctx.fillRect(barX, barY, barW, barH);
        const hpW = Math.round((state.hp / state.maxHp) * barW);
        const krW = Math.round((state.kr / state.maxHp) * barW);
        ctx.fillStyle = '#ffff00';
        ctx.fillRect(barX, barY, Math.max(0, hpW - krW), barH);
        ctx.fillStyle = '#ff00ff';
        ctx.fillRect(barX + Math.max(0, hpW - krW), barY, krW, barH);

        ctx.fillStyle = state.kr > 0 ? '#ff00ff' : '#ffffff';
        ctx.font = 'bold 19px "Courier New", monospace';
        ctx.fillText(`${state.kr > 0 ? 'KR ' : ''}${state.hp} / ${state.maxHp}`, barX + barW + 14, 417);

        BUTTONS.forEach((label, idx) => {
          const bx = 34 + idx * 150;
          const by = 432;
          const bw = 118;
          const bh = 40;
          const active = state.phase === 'MENU' && state.menuIdx === idx;
          const col = (state.mercyOffered && idx === 3) ? '#ffff00' : (active ? '#ffff00' : '#ff7f27');

          ctx.strokeStyle = col;
          ctx.lineWidth = 3;
          ctx.strokeRect(bx, by, bw, bh);

          if (active) drawPixelHeart(bx + 16, by + 20, '#ff0000', 1.1);
          else drawButtonIcon(label, bx + 10, by + 10, col);

          ctx.fillStyle = col;
          ctx.font = 'bold 21px "Courier New", monospace';
          ctx.fillText(label, bx + 32, by + 28);
        });

        for (const mb of state.menuBones) {
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(Math.round(mb.x), 426, 8, 50);
          ctx.fillRect(Math.round(mb.x - 2), 424, 12, 5);
          ctx.fillRect(Math.round(mb.x - 2), 473, 12, 5);
        }

        ctx.restore();
      }

      function loop() {
        update();
        draw();
        requestAnimationFrame(loop);
      }
      loop();
    </script>
  </body>
</html>
