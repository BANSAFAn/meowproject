      function drawCatSans(cx, tick, eyeGlow, isDodging, yOff = 0) {
        const panic = (state.phase === 'AFK_CHECK' && state.afkStage === 2) || state.phase === 'AFK_REPLY';
        const heavy = state.bossPhase === 3 || state.phase === 'FINAL_TEA' || panic;
        const trembleX = panic ? Math.round((Math.random() - 0.5) * 4) : 0;
        const drawCx = cx + trembleX;
        const headBob = Math.round(Math.sin(tick * (heavy ? 0.14 : 0.09)) * (heavy ? 3.5 : 2)) + yOff;
        const bodyBob = Math.round(Math.sin(tick * (heavy ? 0.14 : 0.09) - 0.6) * (heavy ? 2.5 : 1.5)) + yOff;
        const scale = 4;

        // Tail
        const tailWag = heavy ? Math.round(Math.sin(tick * 0.06) * 3) : Math.round(Math.sin(tick * 0.13) * 8);
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(Math.round(drawCx + 42), 178 + bodyBob, 14, 6);
        ctx.fillRect(Math.round(drawCx + 52), 166 + bodyBob + Math.round(tailWag * 0.4), 6, 16);
        ctx.fillRect(Math.round(drawCx + 56), 150 + bodyBob + tailWag, 6, 18);

        drawPixelMatrix(SANS_BODY, drawCx, 148 + bodyBob, scale);

        const glowCol = eyeGlow
          ? (Math.floor(tick / 4) % 2 === 0 ? '#00e5ff' : '#ffff00')
          : '#ffffff';
        const confused =
          state.phase === 'PET_AIR_DIALOGUE' ||
          (state.phase === 'AFK_CHECK' && state.afkStage === 1) ||
          (state.phase === 'P3_MERCY_TRAP' && state.p3MercyIdx < 2);
        const headMat = (state.mercyOffered || state.phase === 'TEA_RESCUE' || state.phase === 'PET_ENDING')
          ? CAT_HEAD_CLOSED
          : confused
            ? CAT_HEAD_CONFUSED
            : heavy
              ? CAT_HEAD_TIRED
              : CAT_HEAD;
        drawPixelMatrix(headMat, drawCx, 84 + headBob, scale, glowCol);

        // Floating "?" when cat is confused ("кого ти гладиш?" / "Ти помер ?")
        if (confused) {
          const qBob = Math.round(Math.sin(tick * 0.12) * 3);
          ctx.fillStyle = '#ffff00';
          ctx.font = 'bold 26px "Courier New", monospace';
          ctx.fillText('?', Math.round(drawCx - 66), 102 + headBob + qBob);
        }

        // Sweat drops in Phase 3 (tired/sad) or AFK panic
        if (heavy && state.phase !== 'PET_ENDING') {
          const dropY = (tick % 40) < 20 ? 96 : 104;
          ctx.fillStyle = '#00e5ff';
          ctx.fillRect(Math.round(drawCx - 38), dropY + headBob, 4, 8);
          ctx.fillRect(Math.round(drawCx + 34), dropY + 4 + headBob, 4, 8);
