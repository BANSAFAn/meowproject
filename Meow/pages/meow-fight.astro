<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Meow Fight — Undertale Cat Simulator | MeowLab</title>
    <style is:global>
      * {
        box-sizing: border-box;
        user-select: none;
        -webkit-user-select: none;
      }
      html, body {
        margin: 0;
        padding: 0;
        width: 100vw;
        height: 100vh;
        background: #000000;
        color: #ffffff;
        font-family: 'Courier New', Courier, monospace;
        overflow: hidden;
      }
      .stage {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #000000;
      }
      #game {
        display: block;
        width: min(100vw, 133.3333vh);
        height: min(100vh, 75vw);
        image-rendering: pixelated;
        image-rendering: crisp-edges;
        background: #000000;
      }
      /* Fullscreen BSOD Final Attack Overlay */
      #bsod-overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: #0078d7;
        color: #ffffff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        padding: 8vh 10vw;
        flex-direction: column;
        justify-content: center;
        gap: 1.4rem;
      }
      #bsod-overlay.active {
        display: flex;
      }
      .bsod-sad {
        font-size: clamp(4.5rem, 11vw, 8.5rem);
        font-weight: 300;
        line-height: 1;
      }
      .bsod-msg {
        font-size: clamp(1.15rem, 2.3vw, 1.7rem);
        line-height: 1.45;
        max-width: 780px;
        font-weight: 400;
      }
      .bsod-pct {
        font-size: clamp(1.05rem, 2vw, 1.4rem);
      }
      .bsod-foot {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        margin-top: 0.8rem;
        flex-wrap: wrap;
      }
      .bsod-qr {
        width: 92px;
        height: 92px;
        background: #ffffff;
        padding: 6px;
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        grid-template-rows: repeat(7, 1fr);
        gap: 2px;
        flex-shrink: 0;
      }
      .bsod-qr span {
        background: #0078d7;
      }
      .bsod-qr span.w {
        background: #ffffff;
      }
      .bsod-meta {
        font-size: 0.92rem;
        line-height: 1.6;
        opacity: 0.95;
      }
      .bsod-actions {
        margin-top: 1rem;
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
      }
      .bsod-actions button,
      .bsod-actions a {
        background: transparent;
        color: #ffffff;
        border: 2px solid #ffffff;
        padding: 0.45rem 1rem;
        font-family: 'Courier New', monospace;
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        text-decoration: none;
      }
      .bsod-actions button:hover,
      .bsod-actions a:hover {
        background: #ffffff;
        color: #0078d7;
      }
      .touch-pad {
        display: none;
        position: fixed;
        bottom: 12px;
        left: 12px;
        right: 12px;
        z-index: 60;
        justify-content: space-between;
        align-items: flex-end;
        pointer-events: none;
      }
      @media (pointer: coarse) {
        .touch-pad { display: flex; }
      }
      .dpad {
        pointer-events: auto;
        display: grid;
        grid-template-columns: repeat(3, 44px);
        grid-template-rows: repeat(3, 44px);
        gap: 4px;
        opacity: 0.72;
      }
      .tbtn {
        background: #000000;
        border: 2px solid #ffffff;
        border-radius: 0;
        color: #ffffff;
        font-family: inherit;
        font-weight: 900;
        font-size: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        touch-action: none;
      }
      .tbtn:active {
        background: #ffff00;
        color: #000000;
      }
      .ab-pad {
        pointer-events: auto;
        display: flex;
        gap: 10px;
        opacity: 0.78;
      }
      .ab-pad .tbtn {
        width: 56px;
        height: 56px;
        border-color: #ff7f27;
        color: #ff7f27;
      }
    </style>
  </head>
