        ctx.fillRect(Math.round(drawCx - 54), 134 + headBob, 12, 3);
        ctx.fillRect(Math.round(drawCx + 42), 126 + headBob, 14, 3);
        ctx.fillRect(Math.round(drawCx + 42), 134 + headBob, 12, 3);

        const tr = T();
        let speech = '';
        if (state.phase === 'INTRO') {
          speech = tr.intro[state.introIdx].slice(0, Math.floor(state.charCount));
        } else if (state.phase === 'TEA_RESCUE') {
          speech = tr.teaRescue[state.teaRescueIdx].slice(0, Math.floor(state.charCount));
        } else if (state.phase === 'AFK_CHECK') {
          const raw = state.afkStage === 1 ? tr.afkAsk : tr.afkPanic;
          speech = raw.slice(0, Math.floor(state.charCount));
        } else if (state.phase === 'AFK_REPLY') {
          speech = tr.afkReply[state.afkReplyIdx].slice(0, Math.floor(state.charCount));
        } else if (state.phase === 'P3_MERCY_TRAP') {
          speech = tr.p3MercyTrap[state.p3MercyIdx].slice(0, Math.floor(state.charCount));
        } else if (state.phase === 'PET_AIR_DIALOGUE') {
          speech = tr.petAirLines[state.petAirIdx].slice(0, Math.floor(state.charCount));
        } else if (state.phase === 'FINAL_TEA') {
          speech = tr.finalTea[state.teaIdx].slice(0, Math.floor(state.charCount));
        } else if (state.catSpeechTimer > 0) {
          speech = state.catSpeech;
