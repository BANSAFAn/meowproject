      function drawPixelMatrix(matrix, cx, cy, scale, glowCol = null) {
        const rows = matrix.length;
        const cols = matrix[0].length;
        const startX = Math.round(cx - (cols * scale) / 2);
        const startY = Math.round(cy);
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            const ch = matrix[r][c];
            if (ch === '0') continue;
            if (ch === '1') ctx.fillStyle = '#ffffff';
            else if (ch === '2') ctx.fillStyle = '#000000';
            else if (ch === '3') ctx.fillStyle = glowCol || '#ffffff';
            ctx.fillRect(startX + c * scale, startY + r * scale, scale, scale);
          }
        }
      }

      function drawPixelHeart(cx, cy, color, scale = 1.2) {
        const rows = HEART_PIXELS.length;
        const cols = HEART_PIXELS[0].length;
        const sx = Math.round(cx - (cols * scale) / 2);
        const sy = Math.round(cy - (rows * scale) / 2);
        ctx.fillStyle = color;
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            if (HEART_PIXELS[r][c] === '1') ctx.fillRect(sx + c * scale, sy + r * scale, Math.ceil(scale), Math.ceil(scale));
          }
        }
      }

      function drawPixelBubble(bx, by, bw, bh, text) {
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(bx + 4, by, bw - 8, bh);
        ctx.fillRect(bx, by + 4, bw, bh - 8);
        ctx.fillRect(bx - 6, by + 26, 6, 12);
        ctx.fillRect(bx - 12, by + 29, 6, 6);
        ctx.fillRect(bx - 16, by + 31, 4, 2);

        ctx.fillStyle = '#000000';
        ctx.font = 'bold 13px "Courier New", monospace';
        text.split('\n').forEach((ln, idx) => {
          ctx.fillText(ln, bx + 12, by + 24 + idx * 19);
        });
      }

      // --- Authentic Undertale Eye-Shaped Pixel FIGHT Target Reticle ---
      function drawUndertaleFightTarget(b, cursorX) {
        const cx = Math.round(b.x + b.w / 2);
        const cy = Math.round(b.y + b.h / 2);
        const halfW = Math.round(b.w / 2) - 18;
        const maxHalfH = Math.round(b.h / 2) - 10;

        // Pixelated tapered eye outline in lime green (#a3e635)
        for (let dx = -halfW; dx <= halfW; dx += 4) {
          const norm = Math.abs(dx) / halfW;
          const h = Math.max(4, Math.round(Math.pow(1 - norm * norm, 0.62) * maxHalfH));
          // Top & bottom lime border pixels
          ctx.fillStyle = '#a3e635';
          ctx.fillRect(cx + dx, cy - h, 4, 4);
          ctx.fillRect(cx + dx, cy + h - 4, 4, 4);
        }

        // End caps (bright lime pointers)
        ctx.fillStyle = '#a3e635';
        ctx.fillRect(cx - halfW - 6, cy - 8, 10, 16);
        ctx.fillRect(cx + halfW - 4, cy - 8, 10, 16);

        // Red outer bars + red horizontal ticks
        const redOff = Math.round(halfW * 0.78);
        const redH = Math.round(maxHalfH * 0.62);
        ctx.fillStyle = '#ef4444';
        ctx.fillRect(cx - redOff, cy - redH, 10, redH * 2);
        ctx.fillRect(cx + redOff - 10, cy - redH, 10, redH * 2);
        for (let tx = redOff - 32; tx > Math.round(halfW * 0.36); tx -= 28) {
          ctx.fillRect(cx - tx, cy - 22, 10, 3);
          ctx.fillRect(cx - tx, cy + 19, 10, 3);
          ctx.fillRect(cx + tx - 10, cy - 22, 10, 3);
          ctx.fillRect(cx + tx - 10, cy + 19, 10, 3);
        }

        // Yellow middle bars + yellow horizontal ticks
        const yelOff = Math.round(halfW * 0.34);
        const yelH = Math.round(maxHalfH * 0.88);
        ctx.fillStyle = '#facc15';
        ctx.fillRect(cx - yelOff, cy - yelH, 10, yelH * 2);
        ctx.fillRect(cx + yelOff - 10, cy - yelH, 10, yelH * 2);
        for (let ty = -30; ty <= 30; ty += 15) {
          ctx.fillRect(cx - yelOff + 22, cy + ty, 10, 3);
          ctx.fillRect(cx - yelOff + 42, cy + ty, 10, 3);
          ctx.fillRect(cx + yelOff - 32, cy + ty, 10, 3);
          ctx.fillRect(cx + yelOff - 52, cy + ty, 10, 3);
        }

        // Green center core with pixel ladder + black center slit
        const coreW = 44;
        ctx.fillStyle = '#a3e635';
        ctx.fillRect(cx - coreW / 2, cy - maxHalfH, coreW, maxHalfH * 2);
        ctx.fillStyle = '#16a34a';
        for (let ly = -maxHalfH + 8; ly < maxHalfH - 8; ly += 10) {
          ctx.fillRect(cx - 16, cy + ly, 10, 6);
          ctx.fillRect(cx + 6, cy + ly, 10, 6);
        }
        ctx.fillStyle = '#000000';
        ctx.fillRect(cx - 5, cy - maxHalfH + 6, 10, maxHalfH * 2 - 12);

        // Crisp white vertical moving slider bar with black outline
        const sx = Math.round(b.x + 16 + cursorX);
        ctx.fillStyle = '#000000';
        ctx.fillRect(sx - 2, b.y + 6, 12, b.h - 12);
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(sx, b.y + 8, 8, b.h - 16);
      }

