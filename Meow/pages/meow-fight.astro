      function detectLang() {
        const q = new URLSearchParams(window.location.search).get('lang');
        if (q && I18N[q]) return q;
        try {
          const saved = localStorage.getItem('meow_lang_manual') || localStorage.getItem('lang');
          if (saved && I18N[saved]) return saved;
        } catch (_) {}
        try {
          if (document.referrer) {
            const refPath = new URL(document.referrer).pathname;
            const m = refPath.match(/^\/(uk|en|de|pl|be|kk)(\/|$)/);
            if (m && I18N[m[1]]) return m[1];
          }
        } catch (_) {}
        const nav = (navigator.language || 'uk').slice(0, 2).toLowerCase();
        return I18N[nav] ? nav : 'uk';
      }

      const curLang = detectLang();
      document.documentElement.lang = curLang;
      const T = () => I18N[curLang] || I18N.uk;

      // --- Phase-Based Background Music + Game Over Track (End.mp3) ---
      const PHASE_TRACKS = {
        1: ['/projects/Phasa%201.mp3'],
        2: ['/projects/Phase%202.mp3', '/projects/Phase%202%20(2).mp3'],
        3: ['/projects/Phase%203.mp3'],
        end: ['/projects/End.mp3']
      };
      const bgm = document.getElementById('bgm');
      let bgmEnabled = true;
      let bgmPhase = 1;
      let bgmTrackIdx = 0;

      function loadBgmTrack(phaseKey, trackIdx, autoPlay = true) {
        const list = PHASE_TRACKS[phaseKey] || PHASE_TRACKS[1];
        bgmPhase = phaseKey;
        bgmTrackIdx = trackIdx % list.length;
        const nextSrc = list[bgmTrackIdx];
        bgm.loop = list.length === 1;
        if (!bgm.src.endsWith(nextSrc)) {
          bgm.src = nextSrc;
          bgm.load();
        }
        bgm.volume = phaseKey === 'end' ? 0.5 : 0.45;
        if (autoPlay && bgmEnabled) {
          const p = bgm.play();
          if (p && p.catch) p.catch(() => {});
        }
      }

      function setBgmPhase(phaseKey, forceRestart = false) {
        if (!forceRestart && bgmPhase === phaseKey) {
          tryStartBgm();
          return;
        }
        bgm.currentTime = 0;
        loadBgmTrack(phaseKey, 0, true);
      }

      bgm.addEventListener('ended', () => {
        if (!bgmEnabled) return;
        const list = PHASE_TRACKS[bgmPhase] || PHASE_TRACKS[1];
        if (list.length > 1) {
          loadBgmTrack(bgmPhase, (bgmTrackIdx + 1) % list.length, true);
        } else {
          bgm.currentTime = 0;
          bgm.play().catch(() => {});
        }
      });

      function tryStartBgm() {
        if (!bgmEnabled) return;
        if (
          typeof state !== 'undefined' &&
          (
            state.phase === 'BSOD' ||
            state.phase === 'FINAL_TEA' ||
            state.phase === 'TEA_RESCUE' ||
            state.phase === 'AFK_CHECK' ||
            state.phase === 'AFK_REPLY' ||
            state.phase === 'P3_MERCY_TRAP' ||
            state.phase === 'PET_ENDING' ||
            (state.phase === 'GAMEOVER' && state.deathTimer < 110)
