      function pickRandomWave(pool) {
        if (!state.waveBag || state.waveBag.length === 0 || state.waveBagPhase !== state.bossPhase) {
          state.waveBag = pool.slice();
          for (let i = state.waveBag.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [state.waveBag[i], state.waveBag[j]] = [state.waveBag[j], state.waveBag[i]];
          }
          if (state.waveBag.length > 1 && state.waveBag[state.waveBag.length - 1] === state.lastWave) {
            [state.waveBag[0], state.waveBag[state.waveBag.length - 1]] = [state.waveBag[state.waveBag.length - 1], state.waveBag[0]];
          }
          state.waveBagPhase = state.bossPhase;
        }
        const choice = state.waveBag.pop();
        state.lastWave = choice;
        return choice;
      }

