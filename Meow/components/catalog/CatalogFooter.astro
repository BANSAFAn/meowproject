---
import MonobankIcon from '../icons/MonobankIcon.astro';
import YoutubeIcon from '../icons/YoutubeIcon.astro';
import type { UITranslations } from '../../i18n/translations';
import { SITE_REPO_URL } from '../../data/projects';

interface Props {
  t: UITranslations;
  brandDisplay: string;
  monobankUrl: string;
  youtubeJoinUrl: string;
}

const { t, brandDisplay, monobankUrl: MONOBANK_URL, youtubeJoinUrl: YOUTUBE_JOIN_URL } = Astro.props;
---
        <footer class="site-footer">
      <div class="container">
        <div class="footer-legal-grid">
          <div style="display: flex; flex-direction: column; gap: 0.5rem;">
            <div class="brand" data-switch-view="catalog">
              <img src="/favicon.svg" alt={brandDisplay} width="28" height="28" />
              <span class="brand-title" style="font-size: 1.05rem;">{brandDisplay}</span>
            </div>
            <p style="font-size: 0.84rem; color: var(--ink-muted); line-height: 1.55;">{t.footerAbout}</p>
            <p style="font-size: 0.8rem; font-weight: 700; color: var(--ink);">{t.footerAlphaNote}</p>
            <p style="font-size: 0.78rem; color: var(--ink-faint);">{t.footerNoAuthNote}</p>
            <p style="font-size: 0.74rem; color: var(--ink-faint);">MeowLab (meowlab.pp.ua) · MeowL · MeowLabs · Baneronetwo</p>
          </div>

          <div>
            <div class="footer-col-title">{t.footerLegalColTitle}</div>
            <div class="footer-legal-links">
              <button type="button" id="open-privacy-btn" class="footer-legal-btn">
                {t.footerPrivacy}
              </button>
              <button type="button" id="open-confidentiality-btn" class="footer-legal-btn">
                {t.footerConfidentiality || 'Конфіденційність даних'}
              </button>
              <button type="button" id="open-terms-btn" class="footer-legal-btn">
                {t.footerTerms}
              </button>
              <button type="button" class="footer-legal-btn" data-switch-view="report" style="color: var(--stamp-red);">
                {t.footerReportThreatLink}
              </button>
            </div>
          </div>

          <div>
            <div class="footer-col-title">{t.footerRepoColTitle}</div>
            <div style="display: flex; flex-direction: column; gap: 0.5rem; align-items: flex-start;">
              <a
                href={SITE_REPO_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="paper-btn"
                style="width: 100%; justify-content: flex-start;"
              >
                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <polygon points="5,4 1,8 5,12 6.5,10.5 4,8 6.5,5.5"></polygon>
                  <polygon points="11,4 15,8 11,12 9.5,10.5 12,8 9.5,5.5"></polygon>
                </svg>
                {t.footerSourceLink} (GPL-3.0)
              </a>

              <a
                href={MONOBANK_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="paper-btn"
                style="width: 100%; justify-content: flex-start;"
              >
                <MonobankIcon size={15} />
                {t.supportMonobank}
              </a>

              <a
                href={YOUTUBE_JOIN_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="paper-btn paper-btn-accent"
                style="width: 100%; justify-content: flex-start;"
              >
                <YoutubeIcon size={15} />
                {t.supportYoutube}
              </a>

              <div class="footer-col-title" style="margin-top: 0.75rem;">{t.contactTitle}</div>
              <div class="footer-icon-row">
                <a
                  href="mailto:baneronetwo@memeware.net"
                  class="paper-btn footer-icon-btn"
                  title="Mail: baneronetwo@memeware.net"
                  aria-label="Mail"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="4" width="20" height="16" rx="2" />
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                  </svg>
                </a>
                <a
                  href="https://discord.com/invite/FEyMjn3mtA"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="paper-btn footer-icon-btn"
                  title="Discord"
                  aria-label="Discord"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z" />
                  </svg>
                </a>
                <a
                  href={`${SITE_REPO_URL}/issues`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="paper-btn footer-icon-btn"
                  title="GitHub Issues"
                  aria-label="GitHub"
                >
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path d="M8 1a7 7 0 0 0-2.2 13.6c.35.06.48-.15.48-.34v-1.2c-1.95.42-2.36-.94-2.36-.94-.32-.8-.78-1.02-.78-1.02-.64-.43.05-.42.05-.42.7.05 1.07.72 1.07.72.63 1.07 1.64.76 2.04.58.06-.45.25-.76.45-.94-1.56-.18-3.2-.78-3.2-3.47 0-.77.27-1.4.72-1.89-.07-.18-.31-.89.07-1.86 0 0 .59-.19 1.93.72a6.7 6.7 0 0 1 3.5 0c1.34-.91 1.93-.72 1.93-.72.38.97.14 1.68.07 1.86.45.49.72 1.12.72 1.89 0 2.7-1.64 3.29-3.21 3.46.25.22.48.65.48 1.31v1.94c0 .19.13.41.48.34A7 7 0 0 0 8 1z" />
                  </svg>
                </a>
                <a
                  href="https://gitlab.com/banernotfake/meowproject/-/issues"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="paper-btn footer-icon-btn"
                  title="GitLab Issues"
                  aria-label="GitLab"
                  style="color: #fc6d26;"
                >
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path d="M14.9 9.1L14.1 6.6L12.5 1.7C12.4 1.4 12 1.4 11.9 1.7L10.3 6.6H5.7L4.1 1.7C4 1.4 3.6 1.4 3.5 1.7L1.9 6.6L1.1 9.1C1 9.4 1.1 9.7 1.3 9.9L8 14.8L14.7 9.9C14.9 9.7 15 9.4 14.9 9.1Z" />
                  </svg>
                </a>
                <a
                  href="https://codeberg.org/Baneronetwo/meowlab/issues"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="paper-btn footer-icon-btn"
                  title="Codeberg Issues"
                  aria-label="Codeberg"
                  style="color: #2185d0;"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M11.955.49A12 12 0 0 0 0 12.49a12 12 0 0 0 1.832 6.372L11.836 5.955a.208.208 0 0 1 .328 0l10.004 12.907A12 12 0 0 0 24 12.49a12 12 0 0 0-12-12c-.015 0-.03 0-.045 0zm.375 6.473l4.426 16.59A12 12 0 0 0 21.842 19.3z" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>

        <div style="margin-top: 1.4rem; padding-top: 1rem; border-top: 1px dashed var(--border-muted); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem;">
          <span style="font-size: 0.8rem; color: var(--ink-muted); font-weight: 700;">
            {t.footerCardsDonate}
          </span>
          <a
            href={MONOBANK_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="paper-btn"
            style="display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.35rem 0.75rem; text-decoration: none;"
            title={t.monobankSupportBtn}
          >
            <svg width="38" height="24" viewBox="0 0 38 24" aria-label="Visa" role="img">
              <rect width="38" height="24" rx="4" fill="#1434CB" />
              <text x="19" y="15.5" text-anchor="middle" fill="#FFFFFF" font-family="Arial, sans-serif" font-weight="900" font-style="italic" font-size="10.5" letter-spacing="0.5">VISA</text>
            </svg>
            <svg width="38" height="24" viewBox="0 0 38 24" aria-label="Mastercard" role="img">
              <rect width="38" height="24" rx="4" fill="#1D1D1B" />
              <circle cx="15" cy="12" r="6.5" fill="#EB001B" />
              <circle cx="23" cy="12" r="6.5" fill="#F79E1B" fill-opacity="0.9" />
            </svg>
            <span style="display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.78rem; font-weight: 800; color: var(--ink);">
              <MonobankIcon size={14} />
              Monobank ↗
            </span>
          </a>
        </div>
      </div>
    </footer>
