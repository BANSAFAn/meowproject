                  <div class="fund-progress-fill" style="width: 35.5%;"></div>
                </div>
                <div class="fund-progress-hint">
                  {t.expCombinedChannels}
                </div>
              </div>

              <div class="expense-meta">
                <span>{t.expGoalDomain}</span>
                <span class="status-indicator-active">{t.expStatusNeedSupport}</span>
              </div>

              <div class="fund-actions">
                <a
                  href={MONOBANK_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="paper-btn paper-btn-accent"
                  style="width: 100%; justify-content: center; text-decoration: none;"
                >
                  <MonobankIcon size={16} />
                  <span>{t.monobankSupportBtn}</span>
                </a>
                <a
                  href={YOUTUBE_JOIN_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="paper-btn"
                  style="width: 100%; justify-content: center; text-decoration: none;"
                >
                  <YoutubeIcon size={16} />
                  <span>{t.supportYoutube}</span>
                </a>
              </div>
            </div>

                        <div class="expense-card future">
              <div class="expense-card-top">
                <span class="stamp">{t.expStatusDev}</span>
                <span class="expense-sum">{t.expStatusPerspective}</span>
              </div>
              <h3 class="expense-title">{t.futureGoalTitle}</h3>
              <p class="expense-desc">{t.futureGoalDesc}</p>
              <div class="expense-meta">
                <span>{t.expGoalTranslation}</span>
                <span class="status-indicator-plan">{t.expStatusPlanned}</span>
              </div>
            </div>
          </div>
        </section>
      </div>

            <div id="view-report" class="tab-view-panel">
        <section class="paper-sheet-box submit-sheet">
          <div class="hero-kicker">{t.reportTabKicker || 'БЕЗПЕКА // РЕЄСТР ЗАГРОЗ'}</div>
          <h1 class="hero-title">{t.reportTabTitle || 'Повідомити про небезпечний проєкт'}</h1>
          <p class="hero-subtitle">
            {t.reportTabSubtitle || 'Виявили вірус, стілер, крадіжку даних, шахрайство або серйозні проблеми з репутацією? Подайте обґрунтовану скаргу з доказами (до 20 000 символів у Markdown) будь-якою мовою через GitHub Issues.'}
          </p>

          <div class="simple-guide-box" style="border-left: 4px solid var(--stamp-red);">
            <div style="display: flex; align-items: center; gap: 0.6rem; border-bottom: 1.5px solid var(--border-ink); padding-bottom: 0.75rem; margin-bottom: 1rem;">
              <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" style="color: var(--stamp-red);">
                <polygon points="8,1 15,14 1,14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="miter"></polygon>
                <rect x="7.2" y="5.5" width="1.6" height="4.5"></rect>
                <rect x="7.2" y="11" width="1.6" height="1.6"></rect>
              </svg>
              <h2 style="font-size: 1.1rem; font-weight: 900; margin: 0; color: var(--ink);">
                {t.reportHowTitle}
              </h2>
            </div>

            <div class="guide-steps-grid">
              <div class="guide-step-card">
                <span class="guide-step-num" style="color: var(--stamp-red);">{t.guideStepWord} 01</span>
                <span class="guide-step-title">{t.reportStep1Title}</span>
                <p class="guide-step-desc">{t.reportStep1Desc}</p>
              </div>
              <div class="guide-step-card">
                <span class="guide-step-num" style="color: var(--stamp-red);">{t.guideStepWord} 02</span>
                <span class="guide-step-title">{t.reportStep2Title}</span>
                <p class="guide-step-desc">{t.reportStep2Desc}</p>
              </div>
              <div class="guide-step-card">
                <span class="guide-step-num" style="color: var(--stamp-red);">{t.guideStepWord} 03</span>
                <span class="guide-step-title">{t.reportStep3Title}</span>
                <p class="guide-step-desc">{t.reportStep3Desc}</p>
              </div>
              <div class="guide-step-card">
                <span class="guide-step-num" style="color: var(--stamp-red);">{t.guideStepWord} 04</span>
                <span class="guide-step-title">{t.reportStep4Title}</span>
                <p class="guide-step-desc">{t.reportStep4Desc}</p>
              </div>
            </div>
          </div>

          <div class="form-card" style="max-width: 820px;">
            <form id="report-danger-form">
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 0.85rem;">
                <div class="suggest-form-field">
                  <label for="report-project-trigger">{t.reportProjectLabel}</label>
                  <div class="paper-select-dropdown" id="report-project-dropdown" data-paper-select="report-project-select">
                    <input type="hidden" id="report-project-select" required />
                    <button
                      type="button"
                      id="report-project-trigger"
                      class="paper-select-trigger"
                      aria-haspopup="listbox"
                      aria-expanded="false"
                    >
                      <span class="paper-select-trigger-text">{t.reportProjectPlaceholder}</span>
                      <svg class="paper-select-chevron" width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <polygon points="3,5 13,5 8,11" />
                      </svg>
                    </button>
                    <div class="paper-select-panel" role="listbox">
                      <div class="paper-select-search-wrap">
                        <input
                          type="text"
                          class="paper-select-search"
                          placeholder={t.reportProjectSearchPlaceholder}
                          aria-label={t.reportProjectSearchPlaceholder}
                        />
                      </div>
                      <div class="paper-select-list">
                        <button type="button" class="paper-select-option is-selected" data-value="" data-label={t.reportProjectPlaceholder} data-search="select project">
                          <span>{t.reportProjectPlaceholder}</span>
                        </button>
                        {PROJECTS.map((p) => (
                          <button
                            type="button"
                            class="paper-select-option"
                            data-value={p.slug}
                            data-label={`${p.name} (${p.category})`}
                            data-search={`${p.name} ${p.slug} ${p.category}`.toLowerCase()}
                          >
                            <span>{p.name}</span>
                            <span class="paper-select-opt-meta">{p.category}</span>
                          </button>
                        ))}
                        <div class="paper-select-empty">{t.reportNoResults}</div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="suggest-form-field">
                  <label for="report-reason-trigger">{t.reportReasonLabel}</label>
                  <div class="paper-select-dropdown" id="report-reason-dropdown" data-paper-select="report-reason-type">
                    <input type="hidden" id="report-reason-type" value="Malware / Virus / Stealer" required />
                    <button
                      type="button"
                      id="report-reason-trigger"
                      class="paper-select-trigger"
                      aria-haspopup="listbox"
                      aria-expanded="false"
                    >
                      <span class="paper-select-trigger-text">{t.reportReasonMalware}</span>
                      <svg class="paper-select-chevron" width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <polygon points="3,5 13,5 8,11" />
                      </svg>
                    </button>
                    <div class="paper-select-panel" role="listbox">
                      <div class="paper-select-list">
                        <button type="button" class="paper-select-option is-selected" data-value="Malware / Virus / Stealer" data-label={t.reportReasonMalware}>
                          <span>{t.reportReasonMalware}</span>
                          <span class="paper-select-opt-meta">Malware</span>
                        </button>
                        <button type="button" class="paper-select-option" data-value="Theft / Scam / Fraud" data-label={t.reportReasonScam}>
                          <span>{t.reportReasonScam}</span>
                          <span class="paper-select-opt-meta">Scam</span>
                        </button>
                        <button type="button" class="paper-select-option" data-value="Bad Reputation / Doxxing / Abuse" data-label={t.reportReasonAbuse}>
                          <span>{t.reportReasonAbuse}</span>
                          <span class="paper-select-opt-meta">Abuse</span>
                        </button>
                        <button type="button" class="paper-select-option" data-value="Fake Online / Bottled Players" data-label={t.reportReasonFakeOnline}>
                          <span>{t.reportReasonFakeOnline}</span>
                          <span class="paper-select-opt-meta">Fake Online</span>
                        </button>
                        <button type="button" class="paper-select-option" data-value="Other Security Issue" data-label={t.reportReasonOther}>
                          <span>{t.reportReasonOther}</span>
                          <span class="paper-select-opt-meta">Security</span>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="suggest-form-field">
                <label for="report-summary">{t.reportSummaryLabel}</label>
                <input
                  type="text"
                  id="report-summary"
                  class="suggest-form-input"
                  maxlength="140"
                  placeholder={t.reportSummaryPlaceholder}
                  required
                />
              </div>

              <div class="suggest-form-field">
                <label for="report-markdown">{t.reportMarkdownLabel}</label>
                <div class="report-md-toolbar">
                  <div class="report-md-tools">
                    <button type="button" class="report-tool-btn" data-md-insert="**текст**">B</button>
                    <button type="button" class="report-tool-btn" data-md-insert="### Заголовок\n">H3</button>
                    <button type="button" class="report-tool-btn" data-md-insert="[посилання](https://)">Link</button>
                    <button type="button" class="report-tool-btn" data-md-insert="![опис фото](https://)">Image</button>
                    <button type="button" class="report-tool-btn" data-md-insert="```\nкод або лог\n```">Code</button>
                  </div>
                  <span id="report-char-counter" class="report-char-counter">0 / 20 000</span>
                </div>
                <textarea
                  id="report-markdown"
                  class="suggest-form-textarea"
                  style="min-height: 220px; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;"
                  maxlength="20000"
                  placeholder={t.reportMarkdownPlaceholder}
                  required
                ></textarea>
              </div>

              <div class="suggest-form-field">
                <label for="report-links">{t.reportLinksLabel}</label>
                <textarea
                  id="report-links"
                  class="suggest-form-textarea"
                  style="min-height: 75px;"
                  placeholder="https://www.virustotal.com/...\nhttps://imgur.com/..."
                ></textarea>
              </div>

              <div style="margin-top: 1rem; display: flex; justify-content: flex-end; gap: 0.75rem;">
                <button type="submit" class="paper-btn" style="background: #991b1b; color: #fff; border-color: #ef4444; font-weight: 900;">
                  {t.reportSubmitBtn}
                </button>
              </div>
            </form>
          </div>
        </section>
      </div>

      <div id="view-discussions" class="tab-view-panel">
        <section class="hero-wrap">
          <div class="paper-sheet-box hero-dossier">
            <div class="hero-inner-card">
              <div class="hero-kicker">{t.discussionsKicker}</div>
              <h1 class="hero-title">{t.discussionsTitle}</h1>
              <p class="hero-subtitle">{t.discussionsSubtitle}</p>
            </div>
          </div>
        </section>

        <section style="margin-bottom: 2rem;">
          <h2 style="font-size: 1.15rem; font-weight: 900; margin-bottom: 0.9rem;">{t.discussionsWhereTitle}</h2>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 0.9rem;">
            <div class="form-card" style="display: flex; flex-direction: column; justify-content: space-between; gap: 0.85rem;">
              <div>
                <div style="font-weight: 900; font-size: 0.98rem; margin-bottom: 0.35rem;">{t.discussionsIdeaTitle}</div>
                <p style="font-size: 0.84rem; color: var(--ink-muted); line-height: 1.45;">{t.discussionsIdeaDesc}</p>
              </div>
              <a href={`${SITE_REPO_URL}/discussions/new?category=ideas`} target="_blank" rel="noopener noreferrer" class="paper-btn paper-btn-primary" style="text-align: center; justify-content: center;">
                {t.discussionsIdeaBtn} ↗
              </a>
            </div>

            <div class="form-card" style="display: flex; flex-direction: column; justify-content: space-between; gap: 0.85rem;">
              <div>
                <div style="font-weight: 900; font-size: 0.98rem; margin-bottom: 0.35rem;">{t.discussionsBugTitle}</div>
                <p style="font-size: 0.84rem; color: var(--ink-muted); line-height: 1.45;">{t.discussionsBugDesc}</p>
              </div>
              <a href={`${SITE_REPO_URL}/issues/new`} target="_blank" rel="noopener noreferrer" class="paper-btn" style="text-align: center; justify-content: center;">
                {t.discussionsBugBtn} ↗
              </a>
            </div>

            <div class="form-card" style="display: flex; flex-direction: column; justify-content: space-between; gap: 0.85rem;">
              <div>
                <div style="font-weight: 900; font-size: 0.98rem; margin-bottom: 0.35rem;">{t.discussionsQaTitle}</div>
                <p style="font-size: 0.84rem; color: var(--ink-muted); line-height: 1.45;">{t.discussionsQaDesc}</p>
              </div>
              <a href={`${SITE_REPO_URL}/discussions/new?category=q-a`} target="_blank" rel="noopener noreferrer" class="paper-btn" style="text-align: center; justify-content: center;">
                {t.discussionsQaBtn} ↗
              </a>
            </div>

            <div class="form-card" style="display: flex; flex-direction: column; justify-content: space-between; gap: 0.85rem;">
              <div>
                <div style="font-weight: 900; font-size: 0.98rem; margin-bottom: 0.35rem;">{t.discussionsGeneralTitle}</div>
                <p style="font-size: 0.84rem; color: var(--ink-muted); line-height: 1.45;">{t.discussionsGeneralDesc}</p>
              </div>
              <a href={`${SITE_REPO_URL}/discussions/new?category=general`} target="_blank" rel="noopener noreferrer" class="paper-btn" style="text-align: center; justify-content: center;">
                {t.discussionsGeneralBtn} ↗
              </a>
            </div>
          </div>
        </section>

        <section>
          <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; margin-bottom: 0.9rem;">
            <h2 style="font-size: 1.15rem; font-weight: 900;">{t.discussionsActiveTitle}</h2>
            <a href={`${SITE_REPO_URL}/discussions`} target="_blank" rel="noopener noreferrer" class="paper-btn">
              {t.discussionsOpenAllBtn} ↗
            </a>
          </div>
          <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            {initialDiscussions.map((disc: any) => (
              <a
                href={disc.url}
                target="_blank"
                rel="noopener noreferrer"
                class="form-card"
                style="display: flex; flex-direction: column; gap: 0.4rem; text-decoration: none; color: inherit; transition: border-color 0.15s ease, transform 0.15s ease;"
              >
                <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; font-size: 0.78rem; color: var(--ink-muted);">
                  <span class="stamp">{disc.category}</span>
                  <span>#{disc.number}</span>
                  <span>@{disc.author}</span>
                  <span>{String(disc.createdAt || '').slice(0, 10)}</span>
                  <span style="margin-left: auto; font-weight: 800;">{disc.commentsCount ?? 0} {t.discussionsCommentsLabel}</span>
                </div>
                <div style="font-size: 1.02rem; font-weight: 900; color: var(--ink);">{disc.title}</div>
                {disc.excerpt && (
                  <p style="font-size: 0.84rem; color: var(--ink-muted); line-height: 1.45;">{disc.excerpt}</p>
                )}
              </a>
            ))}
          </div>
        </section>
      </div>

      <div id="view-i10n" class="tab-view-panel">
        <section class="hero-wrap">
          <div class="paper-sheet-box hero-dossier">
            <div class="hero-inner-card">
              <div class="hero-kicker">{t.i10nKicker}</div>
              <h1 class="hero-title">{t.i10nTitle}</h1>
              <p class="hero-subtitle">{t.i10nSubtitle}</p>
              <div style="margin-top: 0.9rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem;">
                <span class="stamp stamp-alpha">{t.i10nStatusBadge}</span>
                <a href="/i10n/" target="_blank" rel="noopener noreferrer" class="paper-btn paper-btn-primary" style="text-decoration: none;">
                  <span>i10n Studio ↗</span>
                </a>
              </div>
            </div>
          </div>
        </section>

        <section style="margin-bottom: 2rem;">
          <div class="form-card" style="max-width: 760px;">
            <h2 style="font-size: 1.1rem; font-weight: 900; margin-bottom: 0.5rem;">{t.i10nDonateTitle}</h2>
            <p style="font-size: 0.88rem; color: var(--ink-muted); line-height: 1.5; margin-bottom: 1.1rem;">
              {t.i10nSubtitle}
            </p>
            <div class="fund-actions" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 0.85rem;">
              <a
                href={MONOBANK_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="paper-btn paper-btn-accent"
                style="width: 100%; justify-content: center; text-decoration: none;"
              >
                <MonobankIcon size={16} />
                <span>{t.monobankSupportBtn}</span>
              </a>
              <a
                href={YOUTUBE_JOIN_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="paper-btn"
                style="width: 100%; justify-content: center; text-decoration: none;"
              >
                <YoutubeIcon size={16} />
                <span>{t.supportYoutube}</span>
              </a>
            </div>
          </div>
        </section>
      </div>
    </main>

    <CatalogFooter
      t={t}
      brandDisplay={brandDisplay}
      monobankUrl={MONOBANK_URL}
      youtubeJoinUrl={YOUTUBE_JOIN_URL}
    />

    <CatalogModals
      t={t}
      monobankUrl={MONOBANK_URL}
    />

    <script id="meow-catalog-config" type="application/json" set:html={JSON.stringify(clientConfig)}></script>
    <script defer src="/scripts/catalog-client.js"></script>
    <script defer src="/data/secret.js"></script>
  </body>
</html>
