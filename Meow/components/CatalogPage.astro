        acceptedCountries,
        initialSlug: initialProjectSlug || null,
        initialCat: initialCategory || 'all',
        tabTitles: {
          catalog: t.navCatalog,
          guide: t.navHowItWorks,
          submit: t.navSubmit,
          expenses: t.navExpenses,
          report: t.navReport,
          discussions: t.navDiscussions,
          i10n: t.navI10n,
        },
        categoryTitles: {
          launcher: t.catLauncher,
          modpack: t.catModpack,
          mod: t.catMod,
          client: t.catClient,
          server: t.catServer,
          website: t.catWebsite,
          project: t.catProject,
        },
        uiStrings: {
          copiedToast: t.copiedToast,
          onlineSuffix: t.serverOnlineSuffix,
          offlineLabel: t.serverOfflineLabel,
          collapseTagsBtn: t.collapseTagsBtn,
          expandTagsBtn: t.expandTagsBtn,
          suggestTitlePrefix: t.suggestTitlePrefix,
          dangerPrefix: t.dangerBadgeLabel,
          dangerTypeLabel: t.dangerModalTypeLabel,
          dangerDateLabel: t.dangerModalDateLabel,
          dangerSummaryDefault: t.dangerModalSummaryDefault,
          catHints: {
            launcher: { guide: t.catHintLauncher, namePh: t.catHintLauncherPh, platPh: 'Windows, macOS, Linux' },
            client: { guide: t.catHintClient, namePh: t.catHintClientPh, platPh: 'Windows, macOS, Linux' },
            modpack: { guide: t.catHintModpack, namePh: t.catHintModpackPh, platPh: 'CurseForge / Modrinth / Minecraft 1.21' },
            mod: { guide: t.catHintMod, namePh: t.catHintModPh, platPh: 'Modrinth / Fabric / NeoForge 1.21' },
            server: { guide: t.catHintServer, namePh: t.catHintServerPh, platPh: 'Java Edition 1.20+ / Bedrock' },
            website: { guide: t.catHintWebsite, namePh: t.catHintWebsitePh, platPh: 'Web / Browser' },
            project: { guide: t.catHintProject, namePh: t.catHintProjectPh, platPh: 'Cross-Platform / CLI / API' },
          },
        },
      }}
    >
      // Anti-XSS & Script Sanitizer Function
      function sanitizePlainText(input) {
        if (!input || typeof input !== 'string') return '';
        return input
          .replace(/<script[\s\S]*?>[\s\S]*?<\/script>/gi, '')
          .replace(/javascript\s*:/gi, '')
          .replace(/data\s*:\s*text\/html/gi, '')
          .replace(/on\w+\s*=/gi, '')
          .replace(/[<>]/g, '');
      }

      function hasForbiddenScriptPayload(input) {
        if (!input || typeof input !== 'string') return false;
        return /(<script|javascript\s*:|onerror\s*=|onload\s*=|<iframe|<object|<embed)/i.test(input);
      }

      function setupPage() {
        const vcGuard = document.getElementById('view-catalog');
        if (vcGuard && vcGuard.dataset.meowInit === '1') return;
        if (vcGuard) vcGuard.dataset.meowInit = '1';
        // 1. Theme Toggle
        const themeBtn = document.getElementById('theme-toggle');
        if (themeBtn && !themeBtn.dataset.bound) {
          themeBtn.dataset.bound = '1';
          themeBtn.addEventListener('click', () => {
            const current = document.documentElement.getAttribute('data-theme') || 'light';
            const next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
