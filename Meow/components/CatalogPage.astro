---
import {
  LANGUAGES,
  UI_TRANSLATIONS,
  type LangCode,
} from '../i18n/translations';
import {
  PROJECTS,
  SITE_REPO,
  SITE_REPO_URL,
} from '../data/projects';
import {
  countryName,
  countryOptions,
  acceptedCountryValues,
  REGION_VALUES,
} from '../data/countries';
import { ClientRouter } from 'astro:transitions';
import MonobankIcon from './icons/MonobankIcon.astro';
import YoutubeIcon from './icons/YoutubeIcon.astro';
import SeoHead from './SeoHead.astro';
import LangFlag from './icons/LangFlag.astro';
import CatalogHeader from './catalog/CatalogHeader.astro';
import CatalogFooter from './catalog/CatalogFooter.astro';
import CatalogModals from './catalog/CatalogModals.astro';
import '../styles/catalog.css';
import reviewsData from '../../public/data/reviews.json';
import discussionsData from '../../public/data/discussions.json';
import repoStatsData from '../../public/data/repo-stats.json';

const initialFluffies = typeof repoStatsData?.stars === 'number' ? repoStatsData.stars : 0;
const initialDiscussions = Array.isArray(discussionsData?.discussions) ? discussionsData.discussions : [];

interface Props {
  lang: LangCode;
  initialProjectSlug?: string;
  initialCategory?: string;
}

const { lang, initialProjectSlug, initialCategory } = Astro.props;

const allRecSorted = [...PROJECTS]
  .filter((p) => !p.dangerReport)
  .sort((a, b) => {
    const scoreA = (reviewsData as any)?.projects?.[a.slug]?.averageRating || 0;
    const scoreB = (reviewsData as any)?.projects?.[b.slug]?.averageRating || 0;
    if (scoreB !== scoreA) return scoreB - scoreA;
    if (Boolean(b.verified) !== Boolean(a.verified)) return b.verified ? 1 : -1;
    if (Boolean(b.sponsor) !== Boolean(a.sponsor)) return b.sponsor ? 1 : -1;
    return a.name.localeCompare(b.name);
  });

const initialRecSet = new Set(
  allRecSorted
    .filter((p) => !initialCategory || initialCategory === 'all' || p.category === initialCategory)
    .slice(0, 5)
    .map((p) => p.slug)
);
const t = UI_TRANSLATIONS[lang];
const langList = Object.values(LANGUAGES);
const currentLangMeta = LANGUAGES[lang];
const flagEmojis: Record<string, string> = {
  uk: '🇺🇦',
  en: '🇬🇧',
  de: '🇩🇪',
  pl: '🇵🇱',
  be: '🇧🇾',
  kk: '🇰🇿',
  cs: '🇨🇿',
  ro: '🇷🇴',
  mo: '🇲🇩',
  hu: '🇭🇺',
  fr: '🇫🇷',
  es: '🇪🇸',
  tr: '🇹🇷',
};

const MONOBANK_URL = 'https://send.monobank.ua/jar/7cQ5hJtFDy';
const YOUTUBE_JOIN_URL = 'https://www.youtube.com/@Baneronetwo/join';

const defaultSubmitIssueUrl = `${SITE_REPO_URL}/issues/new?template=submit-project.yml&title=${encodeURIComponent('project: ')}`;
const submitPrUrl = `${SITE_REPO_URL}/pulls`;

function getLangHref(targetLang: LangCode) {
  return targetLang === 'uk' ? '/' : `/${targetLang}/`;
}

function getProjectHref(targetLang: LangCode, slug: string) {
  return targetLang === 'uk' ? `/project/${slug}/` : `/${targetLang}/project/${slug}/`;
}

function getCategoryHref(targetLang: LangCode, category: string) {
  return targetLang === 'uk' ? `/category/${category}/` : `/${targetLang}/category/${category}/`;
}

const PREFIXES = ['launcher', 'modpack', 'mod', 'client', 'server', 'website', 'youtuber', 'project'] as const;

const categoryCounts: Record<string, number> = Object.fromEntries(
  PREFIXES.map((c) => [c, PROJECTS.filter((p) => p.category === c).length]),
);

const allUniqueTags = Array.from(
  new Set(PROJECTS.flatMap((p) => p.tags || []))
).filter(Boolean);

const selectedProject = initialProjectSlug
  ? PROJECTS.find((p) => p.slug === initialProjectSlug)
  : undefined;

const similarByTagsList = selectedProject
  ? [...PROJECTS]
      .filter((p) => p.slug !== selectedProject.slug)
      .map((p) => {
        const selTags = new Set((selectedProject.tags || []).map((x) => x.toLowerCase()));
        const shared = (p.tags || []).filter((x) => selTags.has(x.toLowerCase()));
        const score = shared.length + (p.category === selectedProject.category ? 0.5 : 0);
        return { project: p, shared, score };
      })
      .filter((x) => x.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 5)
  : [];

const singleRecList = selectedProject
  ? allRecSorted.filter((p) => p.slug !== selectedProject.slug && p.category === selectedProject.category).slice(0, 5)
  : [];

const brandDisplay = lang === 'uk' ? 'МяуЛаб' : 'MeowLab';

let pageTitle = t.metaTitle;
let pageDescription = t.metaDescription;

if (selectedProject) {
  const pTagline = selectedProject.locales[lang]?.tagline || selectedProject.name;
  pageTitle = `${selectedProject.name} — ${brandDisplay} | ${currentLangMeta.name}`;
  pageDescription = `${selectedProject.name}: ${pTagline} (${selectedProject.platforms.join(', ')}). ${t.openDirectorySub}`;
} else if (initialCategory && initialCategory !== 'all') {
  pageTitle = `${initialCategory.toUpperCase()} — ${brandDisplay} | ${currentLangMeta.name}`;
}

const SOURCE_HOSTS = [
  { value: 'github', label: 'GitHub', domains: 'github.com' },
  { value: 'gitlab', label: 'GitLab', domains: 'gitlab.com' },
  { value: 'gitea', label: 'Gitea', domains: 'gitea.com' },
  { value: 'sourceforge', label: 'SourceForge', domains: 'sourceforge.net' },
  { value: 'gitee', label: 'Gitee', domains: 'gitee.com' },
  { value: 'cnb', label: 'CNB', domains: 'cnb.cool' },
];

const countryList = countryOptions(lang);
const acceptedCountries = acceptedCountryValues();
const COUNTRY_ALIASES: Record<string, string> = {
  ua: 'UA', ukr: 'UA', ukraine: 'UA', 'україна': 'UA', 'украина': 'UA',
  us: 'US', usa: 'US', 'united states': 'US', america: 'US', 'сша': 'US',
  cn: 'CN', chn: 'CN', china: 'CN', 'китай': 'CN',
  de: 'DE', deu: 'DE', germany: 'DE', deutschland: 'DE', 'німеччина': 'DE', 'германия': 'DE',
  gb: 'GB', uk: 'GB', britain: 'GB', 'united kingdom': 'GB', england: 'GB', 'велика британія': 'GB', 'британія': 'GB',
  pl: 'PL', pol: 'PL', poland: 'PL', polska: 'PL', 'польща': 'PL',
  ca: 'CA', can: 'CA', canada: 'CA', 'канада': 'CA',
  fr: 'FR', fra: 'FR', france: 'FR', 'франція': 'FR',
  nl: 'NL', nld: 'NL', netherlands: 'NL', holland: 'NL', 'нідерланди': 'NL',
  jp: 'JP', jpn: 'JP', japan: 'JP', 'японія': 'JP',
  kr: 'KR', kor: 'KR', 'south korea': 'KR', korea: 'KR', 'корея': 'KR',
  cz: 'CZ', cze: 'CZ', czechia: 'CZ', 'czech republic': 'CZ', 'чехія': 'CZ',
  it: 'IT', ita: 'IT', italy: 'IT', 'італія': 'IT',
  es: 'ES', esp: 'ES', spain: 'ES', 'іспанія': 'ES',
  se: 'SE', swe: 'SE', sweden: 'SE', 'швеція': 'SE',
  fi: 'FI', fin: 'FI', finland: 'FI', 'фінляндія': 'FI',
  no: 'NO', nor: 'NO', norway: 'NO', 'норвегія': 'NO',
  br: 'BR', bra: 'BR', brazil: 'BR', 'бразилія': 'BR',
  au: 'AU', aus: 'AU', australia: 'AU', 'австралія': 'AU',
  kz: 'KZ', kaz: 'KZ', kazakhstan: 'KZ', 'казахстан': 'KZ',
  by: 'BY', blr: 'BY', belarus: 'BY', 'білорусь': 'BY', 'беларусь': 'BY',
  ru: 'RU', rus: 'RU', russia: 'RU', 'росія': 'RU', 'россия': 'RU', 'рф': 'RU',
  eu: 'EU', europe: 'EU', 'європа': 'EU',
  global: 'GLOBAL', international: 'GLOBAL', world: 'GLOBAL', 'глобальний': 'GLOBAL', 'міжнародний': 'GLOBAL', 'світ': 'GLOBAL',
};

const normalizeCountryCode = (raw: string) => {
  const s = (raw || '').trim();
  if (s.includes(',')) {
    return s.split(',').map((p) => {
      const c = p.trim().toLowerCase();
      return COUNTRY_ALIASES[c] || p.trim().toUpperCase();
    }).filter(Boolean).join(', ');
  }
  const clean = s.toLowerCase();
  return COUNTRY_ALIASES[clean] || s.toUpperCase();
};

const KNOWN_FLAG_CODES = new Set([
  'CN', 'US', 'DE', 'GB', 'UA', 'PL', 'CA', 'FR', 'NL', 'JP', 'KR',
  'CZ', 'IT', 'ES', 'SE', 'FI', 'NO', 'BR', 'AU', 'KZ', 'BY', 'RU', 'EU', 'GLOBAL',
]);

const projectCountry = (code: string) => {
  const norm = normalizeCountryCode(code);
  const res = countryName(norm, lang, t.countryGlobal);
  return res === norm && code ? code : res;
};

const siteOrigin = Astro.site?.origin || 'https://meowlab.pp.ua';
const canonicalUrl = selectedProject
  ? `${siteOrigin}${getProjectHref(lang, selectedProject.slug)}`
  : initialCategory && initialCategory !== 'all'
    ? `${siteOrigin}${getCategoryHref(lang, initialCategory)}`
    : `${siteOrigin}${getLangHref(lang)}`;

const seoPageTitle = pageTitle.includes('MeowLab') ? pageTitle : `${pageTitle} | MeowLab`;
const seoKeywords = `meowlab, meowl, meowlabs, baneronetwo, meowlab.pp.ua, MeowProject, ${t.metaKeywords || ''}`;
const seoCategoryMap: Record<string, string> = {
  launcher: t.catLauncher,
  modpack: t.catModpack,
  mod: t.catMod,
  client: t.catClient,
  server: t.catServer,
  website: t.catWebsite,
  youtuber: t.catYoutuber || 'Ютубери',
  project: t.catProject,
};
const seoCategoryLabel = selectedProject
  ? seoCategoryMap[selectedProject.category] || selectedProject.category
  : initialCategory && initialCategory !== 'all'
    ? seoCategoryMap[initialCategory] || initialCategory
    : undefined;

const clientConfig = {
  repo: SITE_REPO,
  repoUrl: SITE_REPO_URL,
  emptyReviewsMsg: t.reviewsEmpty,
  verifiedLabel: t.verifiedViaGithub,
  ratingLabel: t.ratingLabel,
  noRatingLabel: t.noRatingYet,
  openTabLabel: t.openFullProjectTabBtn,
  uiLang: lang,
  acceptedCountries,
  initialSlug: initialProjectSlug || null,
  initialCat: initialCategory || 'all',
  tabTitles: {
    catalog: t.navCatalog,
    guide: t.navHowItWorks,
    submit: t.navSubmit,
    expenses: t.navExpenses,
    report: t.navReport,
    discussions: t.navDiscussions,
    i10n: t.navI10n,
  },
  categoryTitles: {
    launcher: t.catLauncher,
    modpack: t.catModpack,
    mod: t.catMod,
    client: t.catClient,
    server: t.catServer,
    website: t.catWebsite,
    youtuber: t.catYoutuber || 'Ютубери',
    project: t.catProject,
  },
  uiStrings: {
    copiedToast: t.copiedToast,
    onlineSuffix: t.serverOnlineSuffix,
    offlineLabel: t.serverOfflineLabel,
    collapseTagsBtn: t.collapseTagsBtn,
    expandTagsBtn: t.expandTagsBtn,
    suggestTitlePrefix: t.suggestTitlePrefix,
    dangerPrefix: t.dangerBadgeLabel,
    dangerTypeLabel: t.dangerModalTypeLabel,
    dangerDateLabel: t.dangerModalDateLabel,
    dangerSummaryDefault: t.dangerModalSummaryDefault,
    catHints: {
      launcher: { guide: t.catHintLauncher, namePh: t.catHintLauncherPh, platPh: 'Windows, macOS, Linux' },
      client: { guide: t.catHintClient, namePh: t.catHintClientPh, platPh: 'Windows, macOS, Linux' },
      modpack: { guide: t.catHintModpack, namePh: t.catHintModpackPh, platPh: 'CurseForge / Modrinth / Minecraft 1.21' },
      mod: { guide: t.catHintMod, namePh: t.catHintModPh, platPh: 'Modrinth / Fabric / NeoForge 1.21' },
      server: { guide: t.catHintServer, namePh: t.catHintServerPh, platPh: 'Java Edition 1.20+ / Bedrock' },
      website: { guide: t.catHintWebsite, namePh: t.catHintWebsitePh, platPh: 'Web / Browser' },
      project: { guide: t.catHintProject, namePh: t.catHintProjectPh, platPh: 'Cross-Platform / CLI / API' },
    },
  },
};
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      if (
        location.protocol === 'http:' &&
        location.hostname !== 'localhost' &&
        location.hostname !== '127.0.0.1' &&
        !location.hostname.endsWith('.local')
      ) {
        location.replace('https://' + location.host + location.pathname + location.search + location.hash);
      }
      try {
        if ((location.pathname === '/' || location.pathname === '/index.html') && !localStorage.getItem('meow_lang_manual')) {
          var ua = navigator.userAgent || '';
          if (!/bot|crawl|spider|slurp|google|bing|yandex|duckduck/i.test(ua)) {
            var supported = ['uk', 'en', 'de', 'pl', 'be', 'kk', 'cs', 'ro', 'mo', 'hu', 'fr', 'es', 'tr'];
            var langs = (navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || '']).map(function (l) {
              return String(l || '').toLowerCase().slice(0, 2);
            });
            var picked = langs.find(function (c) { return supported.indexOf(c) !== -1; }) || 'en';
            if (picked !== 'uk') {
              location.replace('/' + picked + '/' + location.search + location.hash);
            }
          }
        }
      } catch (_) {}
    </script>
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; img-src 'self' https://avatars.githubusercontent.com https://gitlab.com https://codeberg.org https://secure.gravatar.com https://www.gravatar.com https://api.mcstatus.io https://i.ytimg.com https://yt3.googleusercontent.com data:; connect-src 'self' https://api.github.com https://gitlab.com https://codeberg.org https://img.shields.io https://api.mcstatus.io https://cloudflareinsights.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'none'; upgrade-insecure-requests;"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <SeoHead
      lang={lang}
      siteOrigin={siteOrigin}
      seoPageTitle={seoPageTitle}
      pageDescription={pageDescription}
      seoKeywords={seoKeywords}
      canonicalUrl={canonicalUrl}
      selectedProject={selectedProject}
      initialCategory={initialCategory}
      categoryLabel={seoCategoryLabel}
      projects={PROJECTS}
      reviewsData={reviewsData}
      heroTitle={t.heroTitle}
      siteRepoUrl={SITE_REPO_URL}
      youtubeJoinUrl={YOUTUBE_JOIN_URL}
    />

    <script is:inline>
      (function () {
        function applyTheme() {
          const saved = localStorage.getItem('meow_theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = saved || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <CatalogHeader
      lang={lang}
      t={t}
      brandDisplay={brandDisplay}
      initialFluffies={initialFluffies}
    />

    <main class="container">
            <div
              id="view-catalog"
              class={`tab-view-panel active ${initialProjectSlug ? 'is-single-project-page' : ''}`}
              data-initial-slug={initialProjectSlug || ''}
              data-initial-cat={initialCategory || 'all'}
            >
                <section class="hero-wrap">
          <div class="paper-sheet-box hero-dossier">
            <div class="hero-inner-card">
              <div class="hero-kicker">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <rect x="2" y="2" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8"></rect>
                  <rect x="5" y="5" width="6" height="2"></rect>
                  <rect x="5" y="9" width="4" height="2"></rect>
                </svg>
                {t.heroKicker}
              </div>

              <h1 class="hero-title">{t.heroTitle}</h1>
              <p class="hero-subtitle">{t.heroSubtitle}</p>

              <div class="hero-actions">
                <button
                  type="button"
                  id="hero-to-catalog-btn"
                  class="paper-btn paper-btn-accent"
                >
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <polygon points="8,14 2,7 6,7 6,2 10,2 10,7 14,7"></polygon>
                  </svg>
                  {t.heroToCatalogBtn}
                </button>

                <button
                  type="button"
                  class="paper-btn paper-btn-ink"
                  data-switch-view="submit"
                >
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <rect x="7" y="2" width="2" height="12"></rect>
                    <rect x="2" y="7" width="12" height="2"></rect>
                  </svg>
                  {t.heroSubmitIssueBtn}
                </button>

                <button
                  type="button"
                  class="paper-btn"
                  data-switch-view="guide"
                >
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path d="M2 1h8l4 4v10H2V1zm2 2v10h8V6H9V3H4z"></path>
                  </svg>
                  {t.heroGuideBtn}
                </button>

                <a
                  href={MONOBANK_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="paper-btn"
                >
                  <MonobankIcon size={15} />
                  {t.supportMonobank}
                </a>

                <a
                  href={YOUTUBE_JOIN_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="paper-btn"
                >
                  <YoutubeIcon size={15} />
                  {t.supportYoutube}
                </a>
              </div>

              <div class="hero-meta-grid">
                <div class="hero-meta-item">
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <rect x="1" y="1" width="6" height="6"></rect>
                    <rect x="9" y="1" width="6" height="6"></rect>
                    <rect x="1" y="9" width="6" height="6"></rect>
                    <rect x="9" y="9" width="6" height="6"></rect>
                  </svg>
                  <span>{PROJECTS.length} · {t.statProjects}</span>
                </div>

                <div class="hero-meta-item">
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path d="M5 7V5a3 3 0 0 1 6 0h-2a1 1 0 0 0-2 0v2h6v7H3V7h2zm0 2v3h6V9H5z"></path>
                  </svg>
                  <span>{t.statNoAuth}</span>
                </div>

                <div class="hero-meta-item">
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <polygon points="8,1 10,6 15,6 11,9.5 12.5,15 8,11.5 3.5,15 5,9.5 1,6 6,6"></polygon>
                  </svg>
                  <span>[rating](0-100)</span>
                </div>

                <div class="hero-meta-item">
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path d="M8 1L2 3.5v4.5c0 3.8 2.6 6.8 6 7.8 3.4-1 6-4 6-7.8V3.5L8 1zm0 2.1l4 1.7v3.2c0 2.7-1.7 5-4 5.9-2.3-.9-4-3.2-4-5.9V4.8l4-1.7z"></path>
                  </svg>
                  <span>Strict CSP · Anti-XSS</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <div class="catalog-workspace" id="catalog-workspace">
          <aside class="paper-sheet-box catalog-sidebar-left" aria-label={t.categoriesSidebarTitle}>
            <div class="sidebar-section-title">
              <span>{t.categoriesSidebarTitle}</span>
              <span>[{PROJECTS.length}]</span>
            </div>
            <div class="index-tabs" role="tablist">
              <a
                href={getLangHref(lang)}
                class={`tab-btn ${!initialCategory || initialCategory === 'all' ? 'active' : ''}`}
                data-category="all"
              >
                <span>{t.catAll}</span>
                <span>{PROJECTS.length}</span>
              </a>
              {PREFIXES.map((cat) => (
                <a
                  href={getCategoryHref(lang, cat)}
                  class={`tab-btn ${initialCategory === cat ? 'active' : ''}`}
                  data-category={cat}
                >
                  <span>{cat}</span>
                  <span>{categoryCounts[cat]}</span>
                </a>
              ))}
            </div>

            {allRecSorted.length > 0 && (
              <div class="sidebar-recommended-box" id="sidebar-recommended-box">
                <div class="sidebar-section-title" style="margin-bottom: 0.5rem;">
                  <span>{t.recommendedSidebarTitle}</span>
                  <span>★</span>
                </div>
                <div class="rec-mini-list">
                  {allRecSorted.map((rec) => {
                    const recScore = (reviewsData as any)?.projects?.[rec.slug]?.averageRating || 0;
                    const isInitRec = initialRecSet.has(rec.slug);
                    return (
                      <a
                        href={getProjectHref(lang, rec.slug)}
                        class="rec-mini-item"
                        data-rec-item={rec.slug}
                        data-rec-cat={rec.category}
                        data-rec-tags={rec.tags.join(',').toLowerCase()}
                        style={isInitRec ? '' : 'display: none;'}
                        title={rec.name}
                      >
                        <img src={rec.icon} alt="" class="rec-mini-icon" width="22" height="22" loading="lazy" />
                        <span class="rec-mini-name">{rec.shortName || rec.name}</span>
                        {rec.verified && (
                          <span class="rec-mini-ver" title={t.verifiedBadge}>
                            <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                              <path d="M8 1L2 3.5v4.5c0 3.8 2.6 6.8 6 7.8 3.4-1 6-4 6-7.8V3.5L8 1zm-1 9.5L4.5 8l1.2-1.2L7 8.1l3.3-3.3L11.5 6 7 10.5z"></path>
                            </svg>
                          </span>
                        )}
                        {recScore > 0 && (
                          <span class="rec-mini-score">{recScore}</span>
                        )}
                      </a>
                    );
                  })}
                </div>
              </div>
            )}
          </aside>

          <div class="catalog-main-col">
                <section id="catalog-filter-bar" class="paper-sheet-box filter-bar">
          <div class="filter-toolbar-top">
            <div class="search-box">
              <svg class="search-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="2" y="2" width="8" height="8"></rect>
                <line x1="10" y1="10" x2="14.5" y2="14.5"></line>
              </svg>
              <input
                type="search"
                id="project-search"
                class="search-input"
                placeholder={t.searchPlaceholder}
              />
