                ))}
                <span class="region-hint">
                  {t.descLangFilled} <strong id="desc-filled-list">—</strong>
                </span>
              </div>
            </div>

            <!-- Live Validation Status & Proceed Links -->
            <div class="checklist-card">
              <div>
                <div class="field-label" style="margin-bottom: 0.35rem;">{t.previewTitleLabel}</div>
