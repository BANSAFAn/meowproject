                            <rect width="24" height="5.33" fill="#FFFFFF" />
                            <rect y="5.33" width="24" height="5.33" fill="#D22730" />
                            <rect y="10.66" width="24" height="5.34" fill="#FFFFFF" />
                          </svg>
                        )}
                        {l.code === 'kk' && (
                          <svg viewBox="0 0 24 16" width="16" height="11" aria-hidden="true">
                            <rect width="24" height="16" fill="#00AFCA" />
                            <circle cx="12" cy="8" r="3.6" fill="#FEC50C" />
                            <rect x="2" y="2" width="1.8" height="12" fill="#FEC50C" />
                          </svg>
                        )}
                      </span>
                      <span class="lang-chip-code mono">{l.short}</span>
                      <span class="lang-chip-label">{l.label}</span>
                      <span class="lang-chip-badge mono"></span>
                    </label>
