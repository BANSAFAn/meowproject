        const COUNTRY_TO_REGION = {
          'cn': 'asia', 'china': 'asia', 'asia': 'asia', 'jp': 'asia', 'kr': 'asia', 'kz': 'asia', 'in': 'asia', 'tw': 'asia', 'hk': 'asia', 'sg': 'asia',
          'de': 'europe', 'gb': 'europe', 'uk': 'europe', 'ua': 'europe', 'pl': 'europe', 'fr': 'europe', 'it': 'europe', 'es': 'europe', 'nl': 'europe', 'be': 'europe', 'ch': 'europe', 'at': 'europe', 'se': 'europe', 'no': 'europe', 'fi': 'europe', 'cz': 'europe', 'sk': 'europe', 'eu': 'europe', 'europe': 'europe', 'europa': 'europe', 'європа': 'europe',
          'us': 'north-america', 'usa': 'north-america', 'ca': 'north-america', 'canada': 'north-america', 'mx': 'north-america', 'north-america': 'north-america', 'сша': 'north-america',
          'br': 'south-america', 'ar': 'south-america', 'south-america': 'south-america',
          'africa': 'africa', 'африка': 'africa',
          'au': 'oceania', 'nz': 'oceania', 'oceania': 'oceania', 'australia': 'oceania',
          'global': 'global', '001': 'global', 'світ': 'global', 'world': 'global'
        };

        function highlightWorldRegion(regionKey, countryDisplayName) {
          const reg = (regionKey || 'global').toLowerCase().trim();
          mapContinents.forEach((c) => {
            const cReg = c.getAttribute('data-region');
            c.classList.toggle('highlighted', reg !== 'global' && cReg === reg);
          });

          if (worldMapModalTitle) {
            worldMapModalTitle.textContent = countryDisplayName
              ? `Географія: ${countryDisplayName}`
              : 'Географічне походження проєкту';
          }

          if (worldMapStatusBanner) {
            worldMapStatusBanner.textContent = REGION_DESCRIPTIONS[reg] || REGION_DESCRIPTIONS['global'];
          }
        }

        function openWorldMap(countryCode, countryDisplayName) {
          if (!worldMapModal) return;
          const reg = COUNTRY_TO_REGION[(countryCode || '').toLowerCase()] || 'global';
          highlightWorldRegion(reg, countryDisplayName);
          worldMapModal.classList.add('open');
          worldMapModal.setAttribute('aria-hidden', 'false');
        }

        function closeWorldMap() {
          if (worldMapModal) {
            worldMapModal.classList.remove('open');
            worldMapModal.setAttribute('aria-hidden', 'true');
          }
        }

        document.querySelectorAll('[data-open-world-map]').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const cCode = btn.getAttribute('data-country-code');
            const cName = btn.getAttribute('data-country-name');
            openWorldMap(cCode, cName);
          });
        });

        mapContinents.forEach((c) => {
          c.addEventListener('click', () => {
            const reg = c.getAttribute('data-region');
            const name = c.getAttribute('data-name');
            highlightWorldRegion(reg, name);
          });
        });

        document.querySelectorAll('[data-select-region]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const reg = btn.getAttribute('data-select-region');
            highlightWorldRegion(reg, btn.textContent);
          });
        });

        if (worldMapClose) worldMapClose.addEventListener('click', closeWorldMap);
        if (worldMapModal) {
          worldMapModal.addEventListener('click', (e) => {
            if (e.target === worldMapModal) closeWorldMap();
          });
        }

        // Check device and window resolution
        function checkDeviceAndResolution() {
          try {
            const ua = navigator.userAgent || '';
            const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(ua) ||
              (navigator.maxTouchPoints > 1 && /Macintosh/i.test(ua) && screen.width < 1024);

            if (isMobile) {
              document.documentElement.classList.add('gate-mobile-blocked');
            } else {
              document.documentElement.classList.remove('gate-mobile-blocked');
            }

            const w = window.innerWidth;
            const h = window.innerHeight;
            const valStr = `${w} × ${h} px`;
            document.querySelectorAll('[data-viewport-val]').forEach((el) => {
              el.textContent = valStr;
            });
          } catch (_) {}
        }

        checkDeviceAndResolution();
        window.addEventListener('resize', checkDeviceAndResolution);
      }

      setupPage();
      document.addEventListener('astro:after-swap', setupPage);
    </script>
  </body>
</html>
