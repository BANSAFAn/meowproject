---
import {
  LANGUAGES,
  UI_TRANSLATIONS,
  type LangCode,
} from '../i18n/translations';
import {
  PROJECTS,
  SITE_REPO,
  SITE_REPO_URL,
} from '../data/projects';
import {
  countryName,
  countryOptions,
  acceptedCountryValues,
  REGION_VALUES,
} from '../data/countries';
import { ClientRouter } from 'astro:transitions';
import MonobankIcon from './icons/MonobankIcon.astro';
import YoutubeIcon from './icons/YoutubeIcon.astro';

interface Props {
  lang: LangCode;
}

const { lang } = Astro.props;
const t = UI_TRANSLATIONS[lang];
const langList = Object.values(LANGUAGES);
const currentLangMeta = LANGUAGES[lang];

const MONOBANK_URL = 'https://send.monobank.ua/jar/7cQ5hJtFDy';
const YOUTUBE_JOIN_URL = 'https://www.youtube.com/@Baneronetwo/join';

const defaultSubmitIssueUrl = `${SITE_REPO_URL}/issues/new?template=submit-project.yml&title=${encodeURIComponent('project: ')}`;
const submitPrUrl = `${SITE_REPO_URL}/pulls`;

function getLangHref(targetLang: LangCode) {
  return targetLang === 'uk' ? '/' : `/${targetLang}/`;
}

const PREFIXES = ['launcher', 'modpack', 'mod', 'client', 'service', 'website', 'project'] as const;

const categoryCounts: Record<string, number> = Object.fromEntries(
  PREFIXES.map((c) => [c, PROJECTS.filter((p) => p.category === c).length]),
);

const SOURCE_HOSTS = [
  { value: 'github', label: 'GitHub', domains: 'github.com' },
  { value: 'gitlab', label: 'GitLab', domains: 'gitlab.com' },
  { value: 'gitea', label: 'Gitea', domains: 'gitea.com' },
  { value: 'sourceforge', label: 'SourceForge', domains: 'sourceforge.net' },
  { value: 'gitee', label: 'Gitee', domains: 'gitee.com' },
  { value: 'cnb', label: 'CNB', domains: 'cnb.cool' },
];

const countryList = countryOptions(lang);
const acceptedCountries = acceptedCountryValues();
const projectCountry = (code: string) => countryName(code, lang, t.countryGlobal);

const siteOrigin = Astro.url?.origin || 'https://meowproject.pages.dev';
const canonicalUrl = `${siteOrigin}${getLangHref(lang)}`;

const jsonLdSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteOrigin}/#website`,
      name: 'MeowProject',
      alternateName: t.metaTitle,
      url: canonicalUrl,
      inLanguage: lang,
      description: t.metaDescription,
      publisher: {
        '@type': 'Person',
        name: 'Baneronetwo',
        url: YOUTUBE_JOIN_URL,
      },
    },
    {
      '@type': 'ItemList',
      name: t.heroTitle,
      itemListElement: PROJECTS.map((p, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        item: {
          '@type': 'SoftwareApplication',
          name: p.name,
          applicationCategory: 'GameApplication',
          operatingSystem: p.platforms.join(', '),
          url: p.primaryLink,
          image: `${siteOrigin}${p.icon}`,
          description: p.locales[lang].tagline,
          license: p.license,
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; img-src 'self' https://avatars.githubusercontent.com data:; connect-src 'self' https://api.github.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; form-action 'none';"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{t.metaTitle}</title>
    <meta name="description" content={t.metaDescription} />
    <meta name="keywords" content={t.metaKeywords} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- Hreflang SEO -->
    <link rel="alternate" hreflang="x-default" href={`${siteOrigin}/`} />
    {
      langList.map((l) => (
        <link
          rel="alternate"
          hreflang={l.code}
          href={`${siteOrigin}${getLangHref(l.code)}`}
        />
      ))
    }

    <!-- Open Graph / Twitter SEO -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MeowProject" />
    <meta property="og:title" content={t.metaTitle} />
    <meta property="og:description" content={t.metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={currentLangMeta.ogLocale} />
    <meta property="og:image" content={`${siteOrigin}/projects/xmcl/screen-1.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.metaTitle} />
    <meta name="twitter:description" content={t.metaDescription} />
    <meta name="twitter:image" content={`${siteOrigin}/projects/xmcl/screen-1.png`} />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdSchema)} />

    <script is:inline>
      (function () {
        function applyTheme() {
          const saved = localStorage.getItem('meow_theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = saved || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
    <ClientRouter />
    <style>
      :root,
      html[data-theme='light'] {
        --desk-bg: #e8e2d5;
        --paper-sheet: #f7f4ec;
        --paper-card: #fcfaf5;
        --paper-inset: #eee9dc;
        --ink: #181615;
        --ink-muted: #524d46;
        --ink-faint: #787167;
        --border-ink: #181615;
        --rule-line: #c9c1b1;
        --shadow-hard: #181615;
        --stamp-red: #991b1b;
        --stamp-red-bg: #fef2f2;
        --stamp-amber: #92400e;
        --stamp-amber-bg: #fef3c7;
        --stamp-green: #166534;
        --stamp-green-bg: #dcfce7;
        --stamp-blue: #1e40af;
        --stamp-blue-bg: #dbeafe;
        --accent: #b45309;
        --grid-dot: rgba(24, 22, 21, 0.08);
      }

      html[data-theme='dark'] {
        --desk-bg: #111110;
        --paper-sheet: #1a1917;
        --paper-card: #22211e;
        --paper-inset: #141311;
        --ink: #ece7df;
        --ink-muted: #b5aea2;
        --ink-faint: #857e73;
        --border-ink: #4a463f;
        --rule-line: #33302b;
        --shadow-hard: #050505;
        --stamp-red: #fca5a5;
        --stamp-red-bg: rgba(153, 27, 27, 0.25);
        --stamp-amber: #fcd34d;
        --stamp-amber-bg: rgba(146, 64, 14, 0.28);
        --stamp-green: #86efac;
        --stamp-green-bg: rgba(22, 101, 52, 0.28);
        --stamp-blue: #93c5fd;
        --stamp-blue-bg: rgba(30, 64, 175, 0.28);
        --accent: #f59e0b;
        --grid-dot: rgba(236, 231, 223, 0.06);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        background-color: var(--desk-bg);
        background-image: radial-gradient(var(--grid-dot) 1px, transparent 1px);
        background-size: 20px 20px;
        color: var(--ink);
        font-family:
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          Roboto,
          sans-serif;
        line-height: 1.6;
        min-height: 100vh;
        transition:
          background-color 180ms ease,
          color 180ms ease;
      }

      body::after {
        content: '';
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 999;
        opacity: 0.035;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button {
        -webkit-appearance: none;
        appearance: none;
        background: none;
        border: none;
        font: inherit;
        color: inherit;
      }

      .mono {
        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          Monaco,
          Consolas,
          'Liberation Mono',
          monospace;
      }

      .container {
        width: 100%;
        max-width: 1140px;
        margin: 0 auto;
        padding: 0 1.25rem;
      }

      /* Top Archival Status Strip */
      .status-strip {
        background: var(--paper-inset);
        border-bottom: 1.5px solid var(--border-ink);
        font-size: 0.78rem;
      }

      .status-strip-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.65rem;
        padding: 0.5rem 0;
      }

      .stamp-list {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.45rem;
      }

      .stamp {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.16rem 0.52rem;
        border: 1px solid var(--border-ink);
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        background: var(--paper-card);
        white-space: nowrap;
      }

      .stamp-alpha {
        background: var(--stamp-amber-bg);
        color: var(--stamp-amber);
        border-color: var(--stamp-amber);
      }

      .stamp-open {
        background: var(--stamp-green-bg);
        color: var(--stamp-green);
        border-color: var(--stamp-green);
      }

      .stamp-opensource-link {
        background: var(--stamp-blue-bg);
        color: var(--stamp-blue);
        border-color: var(--stamp-blue);
        box-shadow: 2px 2px 0 var(--shadow-hard);
        cursor: pointer;
        transition:
          transform 100ms ease,
          box-shadow 100ms ease;
      }

      .stamp-opensource-link:hover {
        transform: translate(1px, 1px);
        box-shadow: 1px 1px 0 var(--shadow-hard);
      }

      .top-links-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.45rem;
      }

      .source-stamp-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.73rem;
        font-weight: 700;
        padding: 0.2rem 0.55rem;
        border: 1px solid var(--border-ink);
        background: var(--paper-card);
        box-shadow: 2px 2px 0 var(--shadow-hard);
        transition:
          transform 120ms ease,
          box-shadow 120ms ease;
      }

      .source-stamp-link:hover {
        transform: translate(1px, 1px);
        box-shadow: 1px 1px 0 var(--shadow-hard);
      }

      .support-mono-link {
        background: var(--paper-card);
        border-color: var(--border-ink);
      }

      .support-yt-link {
        background: var(--stamp-red-bg);
        color: var(--stamp-red);
        border-color: var(--stamp-red);
      }

      /* Header Sheet */
      .site-header {
        background: var(--paper-sheet);
        border-bottom: 2px solid var(--border-ink);
        position: sticky;
        top: 0;
        z-index: 50;
      }

      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.8rem 0;
        flex-wrap: wrap;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        cursor: pointer;
      }

      .brand-icon {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
      }

      .brand-title {
        font-size: 1.2rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        display: block;
        line-height: 1.1;
      }

      .brand-sub {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.68rem;
        color: var(--ink-faint);
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }

      .header-controls {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      /* 3 Distinct Paper Folder Navigation Tabs */
      .nav-folder-tabs {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        flex-wrap: wrap;
      }

      .folder-tab-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.45rem 0.85rem;
        font-size: 0.84rem;
        font-weight: 700;
        color: var(--ink);
        background-color: var(--paper-card);
        border: 1.5px solid var(--border-ink);
        box-shadow: 2px 2px 0 var(--shadow-hard);
        cursor: pointer;
        transition:
          transform 120ms ease,
          box-shadow 120ms ease,
          background-color 120ms ease,
          color 120ms ease;
      }

      .folder-tab-btn:hover {
        transform: translate(1px, 1px);
        box-shadow: 1px 1px 0 var(--shadow-hard);
      }

      .folder-tab-btn.active {
        background-color: var(--accent);
        color: #ffffff;
        border-color: var(--border-ink);
        box-shadow: 2px 2px 0 var(--shadow-hard);
      }

      .folder-tab-badge {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.68rem;
        padding: 0.05rem 0.35rem;
        border: 1px solid currentColor;
      }

      /* Flag Language Switcher */
      .lang-bar {
        display: inline-flex;
        align-items: center;
        background: var(--paper-inset);
        border: 1.5px solid var(--border-ink);
        padding: 2px;
        gap: 2px;
        box-shadow: 2px 2px 0 var(--shadow-hard);
      }

      .lang-flag-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 26px;
        border: 1px solid transparent;
        background: transparent;
        transition:
          transform 120ms ease,
          background 120ms ease,
          border-color 120ms ease;
      }

      .lang-flag-btn svg {
        width: 20px;
        height: 14px;
        border: 1px solid rgba(0, 0, 0, 0.25);
        display: block;
      }

      .lang-flag-btn:hover {
        background: var(--paper-card);
        transform: translateY(-1px);
      }

      .lang-flag-btn.active {
        background: var(--paper-card);
        border-color: var(--border-ink);
        box-shadow: inset 0 -2px 0 var(--accent);
      }

      /* Theme Toggle Button */
      .theme-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 32px;
        background: var(--paper-card);
        color: var(--ink);
        border: 1.5px solid var(--border-ink);
        box-shadow: 2px 2px 0 var(--shadow-hard);
        cursor: pointer;
        transition:
          transform 120ms ease,
          box-shadow 120ms ease;
      }

      .theme-btn:hover {
        transform: translate(1px, 1px);
        box-shadow: 1px 1px 0 var(--shadow-hard);
      }

      html[data-theme='light'] .icon-moon {
        display: block;
      }
      html[data-theme='light'] .icon-sun {
        display: none;
      }
      html[data-theme='dark'] .icon-moon {
        display: none;
      }
      html[data-theme='dark'] .icon-sun {
        display: block;
      }

      /* Main Views Management */
      .tab-view-panel {
        display: none;
        animation: paperSlideIn 220ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      .tab-view-panel.active {
        display: block;
      }

      @keyframes paperSlideIn {
        from {
          opacity: 0;
          transform: translateY(6px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .paper-sheet-box {
        background: var(--paper-sheet);
        border: 1.5px solid var(--border-ink);
        box-shadow: 5px 5px 0 var(--shadow-hard);
        position: relative;
      }

      .paper-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        padding: 0.55rem 1rem;
        font-size: 0.86rem;
        font-weight: 700;
        font-family: inherit;
        border: 1.5px solid var(--border-ink);
        background-color: var(--paper-card);
        color: var(--ink);
        box-shadow: 3px 3px 0 var(--shadow-hard);
        cursor: pointer;
        transition:
          transform 120ms ease,
          box-shadow 120ms ease,
          background-color 120ms ease;
      }

      .paper-btn:hover {
        transform: translate(1.5px, 1.5px);
        box-shadow: 1.5px 1.5px 0 var(--shadow-hard);
      }

      .paper-btn:active {
        transform: translate(3px, 3px);
        box-shadow: 0 0 0 var(--shadow-hard);
      }

      .paper-btn-ink {
        background-color: var(--ink);
        color: var(--paper-sheet);
      }

      .paper-btn-accent {
        background-color: var(--accent);
        color: #ffffff;
      }

      /* Hero Dossier Sheet */
      .hero-wrap {
        margin: 2rem 0 1.75rem;
      }

      .hero-dossier {
        padding: 2rem 2.25rem;
        background-image: repeating-linear-gradient(
          transparent,
          transparent 31px,
          var(--rule-line) 31px,
          var(--rule-line) 32px
        );
      }

      .hero-inner-card {
        background: var(--paper-sheet);
        border: 1.5px solid var(--border-ink);
        padding: 1.75rem 2rem;
      }

      .hero-kicker {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.74rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 0.2rem 0.55rem;
        border: 1px solid var(--border-ink);
        background: var(--paper-inset);
        margin-bottom: 0.9rem;
      }

      .hero-title {
        font-size: clamp(1.75rem, 3.4vw, 2.5rem);
        font-weight: 900;
        letter-spacing: -0.03em;
        line-height: 1.15;
        margin-bottom: 0.85rem;
      }

      .hero-subtitle {
        font-size: 0.98rem;
        color: var(--ink-muted);
        max-width: 78ch;
        margin-bottom: 1.4rem;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        padding-bottom: 1.4rem;
        border-bottom: 1.5px dashed var(--rule-line);
        margin-bottom: 1.25rem;
      }

      .hero-meta-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 0.75rem;
      }

      .hero-meta-item {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.55rem 0.75rem;
        background: var(--paper-card);
        border: 1px solid var(--border-ink);
        font-size: 0.82rem;
        font-weight: 700;
      }

      /* Filter & Index Tabs */
      .filter-bar {
        margin-bottom: 2rem;
        padding: 1.1rem 1.35rem;
      }

      .search-box {
        position: relative;
        width: 100%;
        margin-bottom: 0.9rem;
      }

      .search-icon {
        position: absolute;
        left: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--ink-faint);
        pointer-events: none;
      }

      .search-input {
        width: 100%;
        padding: 0.6rem 0.85rem 0.6rem 2.35rem;
        background: var(--paper-card);
        color: var(--ink);
        border: 1.5px solid var(--border-ink);
        font-family: inherit;
        font-size: 0.88rem;
      }

      .search-input:focus {
        outline: 2px solid var(--accent);
        outline-offset: -2px;
      }

      .index-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        border-top: 1px dashed var(--rule-line);
        padding-top: 0.9rem;
      }

      .tab-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.38rem 0.75rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.78rem;
        font-weight: 700;
        background-color: var(--paper-card);
        color: var(--ink-muted);
        border: 1.5px solid var(--border-ink);
        cursor: pointer;
        transition:
          transform 100ms ease,
          background-color 100ms ease;
      }

      .tab-btn:hover {
        color: var(--ink);
        transform: translateY(-1px);
      }

      .tab-btn.active {
        background-color: var(--ink);
        color: var(--paper-sheet);
        box-shadow: 2px 2px 0 var(--accent);
      }

      /* Project Dossier Sheet */
      .projects-stack {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
        margin-bottom: 3.5rem;
      }

      .project-dossier {
        background: var(--paper-sheet);
        border: 1.5px solid var(--border-ink);
        box-shadow: 6px 6px 0 var(--shadow-hard);
      }

      .dossier-top-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0.45rem 1.25rem;
        background: var(--paper-inset);
        border-bottom: 1.5px solid var(--border-ink);
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.73rem;
        color: var(--ink-muted);
      }

      .dossier-header {
        padding: 1.5rem 1.75rem;
        border-bottom: 1.5px solid var(--border-ink);
        background: var(--paper-card);
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1.25rem;
      }

      .dossier-identity {
        display: flex;
        align-items: flex-start;
        gap: 1.15rem;
        flex: 1 1 360px;
      }

      .dossier-icon-frame {
        width: 72px;
        height: 72px;
        background: var(--paper-sheet);
        border: 1.5px solid var(--border-ink);
        box-shadow: 3px 3px 0 var(--shadow-hard);
        padding: 0.55rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .dossier-icon-frame img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .dossier-stamps {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.45rem;
        margin-bottom: 0.45rem;
      }

      .dossier-title {
        font-size: 1.45rem;
        font-weight: 900;
        letter-spacing: -0.02em;
        margin-bottom: 0.25rem;
      }

      .prefix-code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        color: var(--accent);
        font-weight: 800;
      }

      .dossier-tagline {
        font-size: 0.92rem;
        color: var(--ink-muted);
      }

      .dossier-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.6rem;
      }

      .dossier-body {
        padding: 1.65rem 1.75rem;
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
      }

      .spec-table {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        border: 1.5px solid var(--border-ink);
        background: var(--paper-card);
      }

      .spec-cell {
        padding: 0.7rem 0.95rem;
        border-right: 1px solid var(--rule-line);
        border-bottom: 1px solid var(--rule-line);
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
      }

      .spec-key {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--ink-faint);
      }

      .spec-val {
        font-size: 0.88rem;
        font-weight: 700;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.45rem;
      }

      .section-head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding-bottom: 0.45rem;
        border-bottom: 1.5px solid var(--border-ink);
        margin-bottom: 0.85rem;
      }

      .section-title {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.92rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.03em;
      }

      .char-stamp {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.72rem;
        padding: 0.1rem 0.45rem;
        border: 1px solid var(--border-ink);
        background: var(--paper-inset);
        white-space: nowrap;
      }

      .description-sheet {
        background: var(--paper-card);
        border: 1.5px solid var(--border-ink);
        padding: 1.2rem 1.35rem;
        font-size: 0.94rem;
        line-height: 1.75;
        white-space: pre-line;
        color: var(--ink);
        border-left: 4px solid var(--accent);
      }

      .features-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 0.6rem;
        margin-top: 0.85rem;
      }

      .feature-box {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        padding: 0.6rem 0.8rem;
        background: var(--paper-card);
        border: 1px solid var(--border-ink);
        font-size: 0.84rem;
        font-weight: 600;
      }

      /* Screenshots */
      .screenshots-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(235px, 1fr));
        gap: 0.9rem;
      }

      .polaroid-card {
        background: var(--paper-card);
        border: 1.5px solid var(--border-ink);
        box-shadow: 3px 3px 0 var(--shadow-hard);
        padding: 0.45rem;
        cursor: pointer;
        text-align: left;
        font-family: inherit;
        color: var(--ink);
        transition:
          transform 120ms ease,
          box-shadow 120ms ease;
      }

      .polaroid-card:hover {
        transform: translate(1.5px, 1.5px);
        box-shadow: 1.5px 1.5px 0 var(--shadow-hard);
      }

      .polaroid-img-wrap {
        aspect-ratio: 16 / 10;
        border: 1px solid var(--border-ink);
        overflow: hidden;
        background: #111;
      }

      .polaroid-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .polaroid-caption {
        padding: 0.5rem 0.25rem 0.2rem;
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--ink-muted);
      }

      .no-screenshots-sheet {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 2rem 1.25rem;
        background: var(--paper-inset);
        border: 1.5px dashed var(--border-ink);
        gap: 0.45rem;
      }

      /* Reviews & Rating [rating](0-100) Section */
      .reviews-sheet {
        background: var(--paper-card);
        border: 1.5px solid var(--border-ink);
        padding: 1.25rem 1.35rem;
      }

      .reviews-top {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        padding-bottom: 0.9rem;
        border-bottom: 1px dashed var(--rule-line);
        margin-bottom: 0.9rem;
      }

      .rating-picker-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.75rem 0.95rem;
        background: var(--paper-sheet);
        border: 1.5px solid var(--border-ink);
        margin-bottom: 0.9rem;
      }

      .rating-slider-wrap {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        flex-wrap: wrap;
      }

      .rating-range-input {
        accent-color: var(--accent);
        width: 140px;
        cursor: pointer;
      }

      .bot-note-strip {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        padding: 0.65rem 0.85rem;
        background: var(--paper-inset);
        border: 1px solid var(--border-ink);
        font-size: 0.82rem;
        color: var(--ink-muted);
        margin-bottom: 1rem;
      }

      .real-reviews-container {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .review-item {
        background: var(--paper-sheet);
        border: 1px solid var(--border-ink);
        padding: 0.9rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
      }

      .review-item-head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.76rem;
      }

      .review-user {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-weight: 700;
      }

      .review-user img {
        width: 20px;
        height: 20px;
        border: 1px solid var(--border-ink);
      }

      .review-body {
        font-size: 0.88rem;
        color: var(--ink);
        white-space: pre-line;
      }

      .reviews-status-box {
        padding: 1.35rem;
        text-align: center;
        background: var(--paper-sheet);
        border: 1px dashed var(--border-ink);
        font-size: 0.85rem;
        color: var(--ink-muted);
      }

      .tags-strip {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        padding-top: 0.5rem;
        border-top: 1px dashed var(--rule-line);
      }

      .tag-item {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.72rem;
        padding: 0.15rem 0.45rem;
        border: 1px solid var(--border-ink);
        background: var(--paper-inset);
      }

      /* =========================================================
         TAB 1: DEDICATED "HOW TO ADD PROJECT" GUIDE VIEW
         ========================================================= */
      .guide-sheet {
        margin: 2rem 0 3.5rem;
        padding: 2rem;
      }

      .prefix-showcase-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 0.75rem;
        margin: 1.15rem 0 2rem;
      }

      .prefix-sample-card {
        background: var(--paper-card);
        border: 1.5px solid var(--border-ink);
        box-shadow: 3px 3px 0 var(--shadow-hard);
        padding: 0.8rem 1rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.84rem;
      }

      .prefix-sample-card strong {
        color: var(--accent);
      }

      .guide-rules-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.1rem;
        margin: 1rem 0 2rem;
      }

      .guide-rule-card {
        background: var(--paper-card);
        border: 1.5px solid var(--border-ink);
        box-shadow: 3px 3px 0 var(--shadow-hard);
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      /* =========================================================
         TAB 2: ANIMATED TUTORIAL & LIVE VALIDATOR FORM VIEW
         Fixed grid baseline alignment & non-wrapping checkboxes!
         ========================================================= */
      .submit-sheet {
        margin: 2rem 0 3.5rem;
        padding: 2rem;
      }

      .anim-stage-box {
        background: var(--paper-inset);
        border: 1.5px solid var(--border-ink);
        padding: 1.5rem;
        margin: 1.25rem 0 2.25rem;
      }

      .anim-progress-track {
        height: 6px;
        background: var(--paper-card);
        border: 1px solid var(--border-ink);
        margin-bottom: 1.25rem;
        overflow: hidden;
      }

      .anim-progress-fill {
        height: 100%;
        width: 25%;
        background: var(--accent);
        transition: width 400ms ease;
      }

      .anim-steps-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 0.9rem;
        margin-bottom: 1.25rem;
      }

      .anim-step-card {
        background: var(--paper-card);
        border: 1.5px solid var(--border-ink);
        padding: 1rem;
        cursor: pointer;
        opacity: 0.6;
        transition:
          opacity 250ms ease,
          transform 250ms ease,
          box-shadow 250ms ease,
          border-color 250ms ease;
      }

      .anim-step-card.active {
        opacity: 1;
        border-color: var(--accent);
        box-shadow: 4px 4px 0 var(--accent);
        transform: translateY(-2px);
      }

      .anim-terminal-preview {
        background: var(--ink);
        color: var(--paper-sheet);
        border: 1.5px solid var(--border-ink);
        padding: 1rem 1.25rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.82rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }

      .pulse-dot {
        display: inline-block;
        width: 9px;
        height: 9px;
        background: #22c55e;
        margin-right: 0.5rem;
        animation: blinkDot 1.2s infinite ease-in-out;
      }

      @keyframes blinkDot {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.25;
        }
      }

      /* Fixed Validator Form Layout */
      .validator-grid {
        display: grid;
        grid-template-columns: 1.35fr 1fr;
        gap: 1.5rem;
        align-items: start;
      }

      .form-card {
        background: var(--paper-card);
        border: 1.5px solid var(--border-ink);
        box-shadow: 4px 4px 0 var(--shadow-hard);
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.15rem;
      }

      .form-row-prefix {
        display: grid;
        grid-template-columns: 165px 1fr;
        gap: 0.9rem;
        align-items: end;
      }

      .form-row-2col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.9rem;
        align-items: end;
      }

      .field-group {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        gap: 0.4rem;
      }

      .field-label {
        font-size: 0.78rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        line-height: 1.3;
      }

      .paper-input,
      .paper-select,
      .paper-textarea {
        width: 100%;
        height: 42px;
        padding: 0.55rem 0.75rem;
        background: var(--paper-sheet);
        color: var(--ink);
        border: 1.5px solid var(--border-ink);
        font-family: inherit;
        font-size: 0.88rem;
      }

      .paper-textarea {
        height: auto;
        min-height: 120px;
        resize: vertical;
      }

      .paper-input:focus,
      .paper-select:focus,
      .paper-textarea:focus {
        outline: 2px solid var(--accent);
        outline-offset: -2px;
      }

      .checklist-card {
        background: var(--paper-card);
        border: 1.5px solid var(--border-ink);
        box-shadow: 4px 4px 0 var(--shadow-hard);
        padding: 1.4rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        position: sticky;
        top: 5.5rem;
      }

      .generated-title-box {
        background: var(--paper-inset);
        border: 1.5px solid var(--border-ink);
        padding: 0.75rem 0.9rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.88rem;
        font-weight: 800;
        word-break: break-all;
      }

      .check-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
      }

      .check-item {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        font-size: 0.83rem;
        font-weight: 600;
        padding: 0.55rem 0.75rem;
        border: 1px solid var(--border-ink);
        background: var(--paper-sheet);
        color: var(--ink-muted);
      }

      .check-box-mark {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-weight: 800;
        white-space: nowrap;
        flex-shrink: 0;
      }

      .check-item.valid {
        background: var(--stamp-green-bg);
        color: var(--stamp-green);
        border-color: var(--stamp-green);
      }

      .paper-btn.disabled {
        opacity: 0.45;
        pointer-events: none;
      }

      /* Footer */
      .site-footer {
        background: var(--paper-sheet);
        border-top: 2px solid var(--border-ink);
        padding: 2.25rem 0;
      }

      .footer-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1.5rem;
      }

      /* Lightbox */
      .lightbox {
        position: fixed;
        inset: 0;
        z-index: 200;
        background: rgba(12, 12, 11, 0.88);
        display: none;
        align-items: center;
        justify-content: center;
        padding: 1.25rem;
      }

      .lightbox.open {
        display: flex;
      }

      .lightbox-frame {
        background: var(--paper-sheet);
        border: 2px solid var(--border-ink);
        box-shadow: 8px 8px 0 #000;
        max-width: 1020px;
        width: 100%;
      }

      .lightbox-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.65rem 1rem;
        border-bottom: 1.5px solid var(--border-ink);
        background: var(--paper-card);
      }

      .lightbox-img-box {
        background: #090909;
        display: flex;
        align-items: center;
        justify-content: center;
        max-height: 78vh;
      }

      .lightbox-img-box img {
        max-width: 100%;
        max-height: 78vh;
        object-fit: contain;
      }

      .no-translation-box {
        background: var(--paper-inset);
        border: 1.5px dashed var(--border-ink);
        padding: 1.5rem;
        margin-top: 0.5rem;
      }

      .no-translation-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.95rem;
      }

      .lang-selector-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        margin: 0.5rem 0 0.8rem;
      }

      .lang-checkbox-hidden {
        position: absolute;
        opacity: 0;
        pointer-events: none;
        width: 0;
        height: 0;
      }

      .lang-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.38rem 0.75rem;
        font-size: 0.8rem;
        font-weight: 700;
        border: 1.5px solid var(--border-ink);
        background: var(--paper-sheet);
        color: var(--ink);
        box-shadow: 2px 2px 0 var(--shadow-hard);
        cursor: pointer;
        user-select: none;
        transition:
          transform 100ms ease,
          box-shadow 100ms ease,
          background-color 120ms ease,
          border-color 120ms ease;
      }

      .lang-chip:hover {
        transform: translate(1px, 1px);
        box-shadow: 1px 1px 0 var(--shadow-hard);
      }

      .lang-chip.selected {
        background: var(--paper-card);
        border-color: var(--accent);
        box-shadow: 2px 2px 0 var(--accent);
      }

      .lang-chip-flag {
        display: inline-flex;
        align-items: center;
        line-height: 1;
        flex-shrink: 0;
      }

      .lang-chip-flag svg {
        border: 1px solid rgba(0, 0, 0, 0.25);
        display: block;
      }

      .lang-chip-code {
        font-weight: 800;
        font-size: 0.82rem;
      }

      .lang-chip-label {
        color: var(--ink-muted);
        font-size: 0.76rem;
      }

      .lang-chip-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 14px;
        height: 14px;
        font-size: 0.68rem;
        border: 1px solid var(--border-ink);
        background: var(--paper-inset);
        color: transparent;
        margin-left: 0.2rem;
        transition: all 120ms ease;
      }

      .lang-chip.selected .lang-chip-badge {
        background: var(--accent);
        border-color: var(--accent);
        color: #ffffff;
      }

      .lang-chip.selected .lang-chip-badge::after {
        content: '✓';
      }

      /* Country / proprietary stamps */
      .stamp-country {
        background: var(--paper-card);
        color: var(--ink);
      }

      .stamp-proprietary {
        background: var(--paper-inset);
        color: var(--ink-muted);
        border-style: dashed;
      }

      .soft-hint {
        display: block;
        margin-top: 0.3rem;
        font-size: 0.76rem;
        color: var(--ink-faint);
      }

      /* Prefix stamp picker */
      .prefix-picker {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
      }

      .prefix-pill {
        padding: 0.42rem 0.8rem;
        font-size: 0.82rem;
        font-weight: 800;
        background: var(--paper-sheet);
        border: 1.5px solid var(--border-ink);
        box-shadow: 2px 2px 0 var(--shadow-hard);
        cursor: pointer;
        transition:
          transform 100ms ease,
          box-shadow 100ms ease,
          background-color 120ms ease,
          color 120ms ease;
      }

      .prefix-pill:hover {
        transform: translate(1px, 1px);
        box-shadow: 1px 1px 0 var(--shadow-hard);
      }

      .prefix-pill.active {
        background: var(--accent);
        color: #fff;
        border-color: var(--border-ink);
        transform: translate(2px, 2px);
        box-shadow: none;
      }

      .region-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.35rem;
      }

      .region-hint {
        font-size: 0.75rem;
        color: var(--ink-faint);
      }

      .region-pill {
        padding: 0.15rem 0.5rem;
        font-size: 0.72rem;
        font-weight: 700;
        border: 1px dashed var(--border-ink);
        background: var(--paper-inset);
        cursor: pointer;
      }

      .region-pill:hover {
        border-style: solid;
        color: var(--accent);
      }

      .field-error {
        display: none;
        font-size: 0.76rem;
        font-weight: 600;
        color: var(--stamp-red);
        background: var(--stamp-red-bg);
        border: 1px solid var(--stamp-red);
        padding: 0.3rem 0.55rem;
      }

      .field-error.visible {
        display: block;
      }

      .paper-textarea-sm {
        min-height: 70px;
      }

      .desc-lang-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 0;
        border-bottom: 1.5px solid var(--border-ink);
      }

      .desc-lang-tab {
        position: relative;
        padding: 0.35rem 0.8rem;
        font-size: 0.78rem;
        font-weight: 800;
        border: 1.5px solid var(--border-ink);
        border-bottom: none;
        margin-right: -1.5px;
        background: var(--paper-inset);
        color: var(--ink-muted);
        cursor: pointer;
      }

      .desc-lang-tab.active {
        background: var(--paper-sheet);
        color: var(--ink);
        box-shadow: inset 0 3px 0 var(--accent);
      }

      .desc-lang-dot {
        display: inline-block;
        width: 6px;
        height: 6px;
        margin-left: 0.35rem;
        border: 1px solid var(--ink-faint);
        vertical-align: middle;
      }

      .desc-lang-dot.filled {
        background: var(--stamp-green);
        border-color: var(--stamp-green);
      }

      .desc-lang-area {
        border-top: none;
      }

      @media (max-width: 860px) {
        .validator-grid,
        .form-row-prefix,
        .form-row-2col {
          grid-template-columns: 1fr;
        }
        .hero-dossier,
        .hero-inner-card,
        .dossier-header,
        .dossier-body,
        .guide-sheet,
        .submit-sheet {
          padding: 1.15rem;
        }
      }
    </style>
  </head>
  <body>
    <!-- Top Archival Status Strip with Monobank & YouTube Support Links -->
    <div class="status-strip">
      <div class="container status-strip-inner">
        <div class="stamp-list">
          <span class="stamp stamp-alpha" title={t.alphaTooltip}>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
