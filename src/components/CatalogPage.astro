                        </span>
                      </div>

                      <div class="real-reviews-container" data-reviews-list>
                        <div class="reviews-status-box" data-reviews-status>
                          {t.loadingLiveReviews}
                        </div>
                      </div>
                    </div>

                    <!-- Tags -->
                    <div class="tags-strip">
                      {project.tags.map((tag) => (
                        <span class="tag-item">#{tag}</span>
                      ))}
                    </div>
                  </div>
                </article>
