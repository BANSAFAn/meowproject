            <div class="form-card">
              <!-- Prefix picker: stamp buttons instead of a native select -->
              <div class="field-group">
                <span class="field-label" id="sub-prefix-label">{t.fieldTypeLabel}</span>
                <input type="hidden" id="sub-prefix" value="launcher" />
                <div class="prefix-picker" role="radiogroup" aria-labelledby="sub-prefix-label">
                  {PREFIXES.map((p, i) => (
                    <button
                      type="button"
                      role="radio"
                      aria-checked={i === 0 ? 'true' : 'false'}
                      class={`prefix-pill mono ${i === 0 ? 'active' : ''}`}
                      data-prefix-value={p}
                    >
                      {p}:
                    </button>
                  ))}
                </div>
              </div>

              <div class="field-group">
                <label class="field-label" for="sub-name">{t.fieldNameLabel}</label>
                <input
                  type="text"
                  id="sub-name"
                  class="paper-input"
                  maxlength="80"
                  autocomplete="off"
                  placeholder={t.fieldNamePlaceholder}
                />
              </div>

              <div class="field-group">
                <label class="field-label" for="sub-country">{t.fieldCountryLabel}</label>
                <input
                  type="text"
                  id="sub-country"
                  class="paper-input"
                  list="country-datalist"
                  autocomplete="off"
                  maxlength="60"
                  placeholder={t.fieldCountryPlaceholder}
                />
                <datalist id="country-datalist">
                  {REGION_VALUES.map((r) => <option value={r} />)}
                  {countryList.map((c) => <option value={c} />)}
                </datalist>
                <div class="region-row">
                  <span class="region-hint">{t.fieldCountryRegionHint}</span>
                  {REGION_VALUES.map((r) => (
                    <button type="button" class="region-pill mono" data-region-value={r}>{r}</button>
                  ))}
                </div>
                <span class="field-error" id="err-country">{t.errCountry}</span>
              </div>

              <div class="field-group">
                <label class="field-label" for="sub-site">{t.fieldSiteLabel}</label>
                <input
                  type="url"
                  id="sub-site"
                  class="paper-input"
                  placeholder={t.fieldSitePlaceholder}
                />
                <span class="field-error" id="err-site">{t.errSite}</span>
              </div>

              <div class="form-row-2col">
                <div class="field-group">
                  <label class="field-label" for="sub-source-host">{t.fieldSourceTypeLabel}</label>
