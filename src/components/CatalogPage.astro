            <MonobankIcon size={13} />
            {t.supportMonobank}
          </a>

          <a
            href={YOUTUBE_JOIN_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="source-stamp-link support-yt-link"
          >
            <YoutubeIcon size={13} />
            {t.supportYoutube}
          </a>

          <a
            href={SITE_REPO_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="source-stamp-link"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
            {t.sourceCode}
          </a>
        </div>
      </div>
    </div>

    <!-- Header with 3 Separate Folder Tabs, Flag Icons & Theme Switcher -->
    <header class="site-header">
      <div class="container header-inner">
        <a href={getLangHref(lang)} class="brand" data-switch-view="catalog">
          <img src="/favicon.svg" alt="MeowProject" class="brand-icon" width="38" height="38" />
          <div>
            <span class="brand-title">MeowProject</span>
            <span class="brand-sub">PAPER ARCHIVE · OPEN DIRECTORY</span>
          </div>
        </a>

        <div class="header-controls">
          <!-- 3 Separate Interactive Tabs -->
          <nav class="nav-folder-tabs" aria-label="Main Views">
            <button
              type="button"
              class="folder-tab-btn active"
              data-view-btn="catalog"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
              </svg>
              <span>{t.navCatalog}</span>
            </button>

            <button
              type="button"
              class="folder-tab-btn"
              data-view-btn="guide"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
              </svg>
              <span>{t.navHowItWorks}</span>
              <span class="folder-tab-badge">01</span>
            </button>

            <button
              type="button"
              class="folder-tab-btn"
              data-view-btn="submit"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
              <span>{t.navSubmit}</span>
              <span class="folder-tab-badge">02</span>
            </button>
          </nav>

          <!-- Language Switcher with Flag Icons Only -->
          <div class="lang-bar" role="navigation" aria-label="Language Switcher">
            <a
              href={getLangHref('uk')}
              class={`lang-flag-btn ${lang === 'uk' ? 'active' : ''}`}
              title="Українська"
              aria-label="Українська"
            >
              <svg viewBox="0 0 24 16" aria-hidden="true">
                <rect width="24" height="8" fill="#0057B7" />
                <rect y="8" width="24" height="8" fill="#FFD700" />
              </svg>
            </a>

            <a
              href={getLangHref('en')}
              class={`lang-flag-btn ${lang === 'en' ? 'active' : ''}`}
              title="English"
              aria-label="English"
            >
              <svg viewBox="0 0 24 16" aria-hidden="true">
                <rect width="24" height="16" fill="#012169" />
                <path d="M0,0 L24,16 M24,0 L0,16" stroke="#FFF" stroke-width="3.2" />
                <path d="M0,0 L24,16 M24,0 L0,16" stroke="#C8102E" stroke-width="1.6" />
                <path d="M12,0 V16 M0,8 H24" stroke="#FFF" stroke-width="5" />
                <path d="M12,0 V16 M0,8 H24" stroke="#C8102E" stroke-width="3" />
              </svg>
            </a>

            <a
              href={getLangHref('de')}
              class={`lang-flag-btn ${lang === 'de' ? 'active' : ''}`}
              title="Deutsch"
              aria-label="Deutsch"
            >
              <svg viewBox="0 0 24 16" aria-hidden="true">
                <rect width="24" height="5.33" fill="#000000" />
                <rect y="5.33" width="24" height="5.33" fill="#DD0000" />
                <rect y="10.66" width="24" height="5.34" fill="#FFCE00" />
              </svg>
            </a>

            <a
              href={getLangHref('pl')}
              class={`lang-flag-btn ${lang === 'pl' ? 'active' : ''}`}
              title="Polski"
              aria-label="Polski"
            >
              <svg viewBox="0 0 24 16" aria-hidden="true">
                <rect width="24" height="8" fill="#FFFFFF" />
                <rect y="8" width="24" height="8" fill="#DC143C" />
              </svg>
            </a>

            <a
              href={getLangHref('be')}
              class={`lang-flag-btn ${lang === 'be' ? 'active' : ''}`}
              title="Беларуская"
              aria-label="Беларуская"
            >
              <svg viewBox="0 0 24 16" aria-hidden="true">
                <rect width="24" height="5.33" fill="#FFFFFF" />
                <rect y="5.33" width="24" height="5.33" fill="#D22730" />
                <rect y="10.66" width="24" height="5.34" fill="#FFFFFF" />
              </svg>
            </a>

            <a
              href={getLangHref('kk')}
              class={`lang-flag-btn ${lang === 'kk' ? 'active' : ''}`}
              title="Қазақша"
              aria-label="Қазақша"
            >
              <svg viewBox="0 0 24 16" aria-hidden="true">
                <rect width="24" height="16" fill="#00AFCA" />
                <circle cx="12" cy="8" r="3.6" fill="#FEC50C" />
                <rect x="2" y="2" width="1.8" height="12" fill="#FEC50C" />
              </svg>
            </a>
          </div>

          <!-- Light / Dark Theme Switcher -->
          <button
            type="button"
            id="theme-toggle"
            class="theme-btn"
            aria-label="Toggle theme"
            title="Switch Light / Dark Paper Theme"
          >
            <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main class="container">
      <!-- =========================================================
           VIEW 0: CATALOG MAIN VIEW
           ========================================================= -->
      <div id="view-catalog" class="tab-view-panel active">
        <!-- Hero Paper Dossier -->
        <section class="hero-wrap">
          <div class="paper-sheet-box hero-dossier">
            <div class="hero-inner-card">
              <div class="hero-kicker">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
                {t.heroKicker}
              </div>

              <h1 class="hero-title">{t.heroTitle}</h1>
              <p class="hero-subtitle">{t.heroSubtitle}</p>

              <div class="hero-actions">
                <button
                  type="button"
                  class="paper-btn paper-btn-ink"
                  data-switch-view="submit"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                  </svg>
                  {t.heroSubmitIssueBtn}
                </button>

                <button
                  type="button"
                  class="paper-btn"
                  data-switch-view="guide"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                  </svg>
                  {t.heroGuideBtn}
                </button>

                <a
                  href={MONOBANK_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="paper-btn"
                >
                  <MonobankIcon size={15} />
                  {t.supportMonobank}
                </a>

                <a
                  href={YOUTUBE_JOIN_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="paper-btn"
                >
                  <YoutubeIcon size={15} />
                  {t.supportYoutube}
                </a>
              </div>

              <div class="hero-meta-grid">
                <div class="hero-meta-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                  </svg>
                  <span>{PROJECTS.length} · {t.statProjects}</span>
                </div>

                <div class="hero-meta-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <rect x="3" y="11" width="18" height="11" rx="1"></rect>
                    <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
                  </svg>
                  <span>{t.statNoAuth}</span>
                </div>

                <div class="hero-meta-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                  </svg>
                  <span>[rating](0-100)</span>
                </div>

                <div class="hero-meta-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  </svg>
                  <span>Strict CSP · Anti-XSS</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Filter & Index Tabs (Removed the "Test No Screenshots" checkbox!) -->
        <section id="catalog-filter-bar" class="paper-sheet-box filter-bar">
          <div class="search-box">
            <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="search"
              id="project-search"
              class="search-input"
              placeholder={t.searchPlaceholder}
            />
          </div>

          <div class="index-tabs" role="tablist">
            <button type="button" class="tab-btn active" data-category="all">
              [ {t.catAll}: {PROJECTS.length} ]
            </button>
            {PREFIXES.map((cat) => (
              <button type="button" class="tab-btn" data-category={cat}>
                [ {cat}: {categoryCounts[cat]} ]
              </button>
            ))}
          </div>
        </section>

        <!-- Dedicated Single-Project Mode Banner (shown when viewing a single project's full tab) -->
        <div
          id="single-project-back-bar"
          style="display: none; margin-bottom: 1.5rem;"
        >
          <button
            type="button"
            id="btn-exit-single-project"
            class="paper-btn paper-btn-ink"
          >
            {t.backToCatalogBtn}
          </button>
        </div>

        <div id="empty-filter-state" class="reviews-status-box" style="display: none; margin-bottom: 2rem;">
          <p>{t.emptyFilterResult}</p>
        </div>

        <!-- Projects Stack -->
        <section class="projects-stack" aria-label="Projects Directory">
          {
            PROJECTS.map((project, index) => {
              const loc = project.locales[lang];
              const hasTranslation = project.availableLangs.includes(lang);
              const desc = hasTranslation ? loc.description : '';
              const tagline = hasTranslation ? loc.tagline : (project.locales.en?.tagline || project.locales.uk?.tagline);
              const features = hasTranslation ? loc.features : (project.locales.en?.features || project.locales.uk?.features || []);
              const primaryProjectLink = project.primaryLink;
              const primaryLinkLabel = project.website ? t.officialSite : t.fallbackProjectLink;
              const cName = projectCountry(project.country);
              const cCode = project.country.toUpperCase();
              const reviewUrl = `${SITE_REPO_URL}/issues/new?title=${encodeURIComponent(`${project.category}: ${project.name}`)}&body=${encodeURIComponent(t.reviewTemplateBody)}`;
              const contributeTranslationUrl = `${SITE_REPO_URL}/issues/new?template=submit-translation.yml&title=${encodeURIComponent(`[i18n: ${project.slug}] ${lang.toUpperCase()} translation`)}&project_slug=${encodeURIComponent(project.slug)}`;

              return (
                <article
                  id={`project-${project.slug}`}
                  class="project-dossier"
                  data-project-card={project.slug}
                  data-category={project.category}
                  data-search={`${project.category}: ${project.name} ${project.shortName} ${tagline} ${cName} ${project.tags.join(' ')}`.toLowerCase()}
                >
                  <!-- Dossier Index Bar -->
                  <div class="dossier-top-bar">
                    <span>ENTRY {String(index + 1).padStart(2, '0')} // {project.category.toUpperCase()}</span>
                    <span data-rating-top-badge={project.slug}></span>
                  </div>

                  <!-- Header -->
                  <div class="dossier-header">
                    <div class="dossier-identity">
                      <div class="dossier-icon-frame">
                        <img src={project.icon} alt={`${project.name} logo`} loading="lazy" decoding="async" width="64" height="64" />
                      </div>

                      <div>
                        <div class="dossier-stamps">
                          <!-- Country Stamp -->
                          <span class="stamp stamp-country" title={`${t.countryOrigin}: ${cName}`}>
                            {cCode === 'CN' && (
                              <svg width="14" height="10" viewBox="0 0 30 20" aria-hidden="true">
                                <rect width="30" height="20" fill="#DE2910" />
                                <polygon fill="#FFDE00" points="5,2 6,5 9,5 6.5,6.8 7.5,9.8 5,8 2.5,9.8 3.5,6.8 1,5 4,5" />
                              </svg>
                            )}
                            {cCode === 'US' && (
                              <svg width="14" height="10" viewBox="0 0 30 20" aria-hidden="true">
                                <rect width="30" height="20" fill="#B22234" />
                                <path d="M0 3h30M0 6.1h30M0 9.2h30M0 12.3h30M0 15.4h30M0 18.5h30" stroke="#FFFFFF" stroke-width="1.5" />
                                <rect width="13" height="10.8" fill="#3C3B6E" />
                              </svg>
                            )}
                            {cCode === 'GLOBAL' && (
                              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="2" y1="12" x2="22" y2="12"></line>
                                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                              </svg>
                            )}
                            {!['CN', 'US', 'GLOBAL'].includes(cCode) && (
                              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                                <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path>
                                <line x1="4" y1="22" x2="4" y2="15"></line>
                              </svg>
                            )}
                            {t.countryOrigin}: {cName}{cCode !== 'GLOBAL' ? ` (${cCode})` : ''}
                          </span>

                          <!-- Clickable source code badges (all mirrors) right next to Country -->
                          {project.isOpenSource ? (
                            project.sourceLinks.map((src) => (
                              <a
                                href={src.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="stamp stamp-opensource-link"
                                title={`${t.openSourceBadge} — ${src.label}`}
                              >
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                                  <polyline points="16 18 22 12 16 6"></polyline>
                                  <polyline points="8 6 2 12 8 18"></polyline>
                                </svg>
                                <span>{t.openSourceBadge} · {src.label}</span>
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" aria-hidden="true">
                                  <path d="M7 17L17 7"></path>
                                  <polyline points="7 7 17 7 17 17"></polyline>
                                </svg>
                              </a>
                            ))
                          ) : (
                            <span class="stamp stamp-proprietary">
                              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                                <rect x="3" y="11" width="18" height="11" rx="1"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                              </svg>
                              {t.proprietaryBadge}
                            </span>
                          )}

                          <span class="stamp stamp-open">{project.license}</span>

                          <!-- Community Rating Stamp (shown only if somebody rated) -->
                          <span class="stamp stamp-alpha" data-rating-stamp={project.slug} style="display: none;">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
                              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                            </svg>
                            <span data-rating-value={project.slug}></span>
                          </span>
                        </div>

                        <h2 class="dossier-title">{project.name}</h2>
                        <p class="dossier-tagline">{tagline}</p>
                      </div>
                    </div>

                    <div class="dossier-links">
                      <a
                        href={primaryProjectLink}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="paper-btn paper-btn-ink"
                      >
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                          <polyline points="15 3 21 3 21 9"></polyline>
                          <line x1="10" y1="14" x2="21" y2="3"></line>
                        </svg>
                        {primaryLinkLabel}
                      </a>
                    </div>
                  </div>

                  <!-- Body -->
                  <div class="dossier-body">
                    <!-- Technical Metadata Strip -->
                    <div class="spec-table">
                      <div class="spec-cell">
                        <span class="spec-key">{t.countryOrigin}</span>
                        <span class="spec-val">{cName}</span>
                      </div>

                      <div class="spec-cell">
                        <span class="spec-key">{t.platformsLabel}</span>
                        <span class="spec-val">{project.platforms.join(' / ')}</span>
                      </div>

                      <div class="spec-cell">
                        <span class="spec-key">{t.officialSite}</span>
                        <span class="spec-val">
                          <a
                            href={primaryProjectLink}
                            target="_blank"
                            rel="noopener noreferrer"
                            style="text-decoration: underline;"
                          >
                            {primaryProjectLink.replace(/^https?:\/\//, '').replace(/\/$/, '')}
                          </a>
                        </span>
                      </div>
                    </div>

                    <!-- Description -->
                    <div>
                      <div class="section-head">
                        <span class="section-title">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="15 2 15 8 21 8"></polyline>
                          </svg>
                          {t.descriptionLabel}
                        </span>
                      </div>

                      {hasTranslation ? (
                        <div>
                          <div class="description-sheet">{desc}</div>

                          <div class="features-list">
                            {features.map((feat) => (
                              <div class="feature-box">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="flex-shrink: 0; margin-top: 2px;">
                                  <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                <span>{feat}</span>
                              </div>
                            ))}
                          </div>
                        </div>
                      ) : (
                        <div class="no-translation-box">
                          <div class="no-translation-header">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <circle cx="12" cy="12" r="10"></circle>
                              <line x1="12" y1="8" x2="12" y2="12"></line>
