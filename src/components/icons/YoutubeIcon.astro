---
interface Props {
  size?: number;
}
const { size = 16 } = Astro.props;
---

<svg
  width={Math.round(size * 1.4)}
  height={size}
  viewBox="0 0 28 20"
  aria-hidden="true"
  style="flex-shrink: 0;"
>
  <rect width="28" height="20" rx="5.5" fill="#FF0000"></rect>
  <path d="M11.2 5.6 L19.2 10 L11.2 14.4 Z" fill="#FFFFFF"></path>
</svg>
